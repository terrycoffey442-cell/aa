    end
    local storyFolder = lobbiesRoot and (lobbiesRoot:FindFirstChild("Story") or lobbiesRoot:WaitForChild("Story", 10))
    if not storyFolder then
        return nil
    end

    local candidates = {}
    for _, model in ipairs(storyFolder:GetChildren()) do
        local owner = model:FindFirstChild("Owner") and model.Owner.Value
        local active = model:FindFirstChild("Active") and model.Active.Value
        local locked = model:FindFirstChild("Locked") and model.Locked.Value
        local teleporting = model:FindFirstChild("Teleporting") and model.Teleporting.Value
