local FARM_RARITY_RANK = {
    Common = 1,
    Rare = 2,
    Epic = 3,
    Legendary = 4,
    Exclusive = 5,
    Mythic = 6,
    Secret = 7,
}

function FarmService:EquipBestTeam()
    if JoinStart and JoinStart.EnsureStarterUnitEquipped then
        pcall(function()
            JoinStart:EnsureStarterUnitEquipped()
        end)
    end

    if not Config.AutoEquipBestTeam then
        return
    end

    local session = GameModules.Session
    local unitsData = GameModules.Units
    local gs = GameModules.GameplaySettings
    if not session or not session.collection or not unitsData then
        return
    end

    local cpd = session.collection.collection_profile_data
    local owned = cpd and cpd.owned_units
    local equipped = cpd and cpd.equipped_units
    if type(owned) ~= "table" or type(equipped) ~= "table" then
        return
    end

    local playerLevel = GameModules:GetPlayerLevel()
    local slotReqs = (gs and gs.UNIT_SLOT_REQUIREMENT) or { ["1"] = 0, ["2"] = 0, ["3"] = 0, ["4"] = 0, ["5"] = 15, ["6"] = 30 }
    local unlockedSlots = {}
    for slotIdx = 1, 6 do
        local sKey = tostring(slotIdx)
        local req = tonumber(slotReqs[sKey]) or 0
        if playerLevel >= req then
            table.insert(unlockedSlots, sKey)
        end
    end

    local candidates = {}
    for uuid, unit in pairs(owned) do
        if type(unit) == "table" and unit.unit_id then
            local def = unitsData[unit.unit_id]
            if def and not def._NO_ATTACKS_UNIT then
                local rRank = FARM_RARITY_RANK[def.rarity or "Common"] or 1
                local dmg = tonumber(def.damage) or 0
                local spa = math.max(tonumber(def.attack_cooldown) or 4, 0.5)
                local dps = dmg / spa
                local evolvedBonus = def.evolved and 1 or 0
                local shinyBonus = unit.shiny and 1 or 0
                table.insert(candidates, {
                    uuid = uuid,
                    unit_id = unit.unit_id,
                    rRank = rRank,
                    evolved = evolvedBonus,
                    shiny = shinyBonus,
                    dps = dps,
                    cost = tonumber(def.cost) or 500,
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        if a.rRank ~= b.rRank then return a.rRank > b.rRank end
        if a.evolved ~= b.evolved then return a.evolved > b.evolved end
        if a.shiny ~= b.shiny then return a.shiny > b.shiny end
        if math.abs(a.dps - b.dps) > 0.01 then return a.dps > b.dps end
        return a.cost < b.cost
    end)

    local desiredTeam = {}
    local usedUnitIds = {}
    for _, cand in ipairs(candidates) do
        if not usedUnitIds[cand.unit_id] then
            usedUnitIds[cand.unit_id] = true
            table.insert(desiredTeam, cand)
            if #desiredTeam >= #unlockedSlots then
                break
            end
        end
    end

    if #desiredTeam == 0 then
        return
    end

    -- Check which desired uuids are already equipped
    local equippedUuidToSlot = {}
    local equippedUnitIds = {}
    for sKey, eqUuid in pairs(equipped) do
        equippedUuidToSlot[eqUuid] = tostring(sKey)
        local uObj = owned[eqUuid]
        if uObj and uObj.unit_id then
            equippedUnitIds[uObj.unit_id] = tostring(sKey)
        end
    end

    for i, cand in ipairs(desiredTeam) do
        local targetSlot = unlockedSlots[i]
        if targetSlot and not equippedUuidToSlot[cand.uuid] and not equippedUnitIds[cand.unit_id] then
            -- Find an empty unlocked slot first, or overwrite targetSlot
            local chosenSlot = nil
            for _, sKey in ipairs(unlockedSlots) do
                if not equipped[sKey] then
                    chosenSlot = sKey
                    break
                end
            end
            chosenSlot = chosenSlot or targetSlot
            log(string.format("Auto equipping best unit %s (%s) into slot %s", tostring(cand.unit_id), tostring(cand.uuid), tostring(chosenSlot)))
            pcall(function()
                GameModules:InvokeServer("equip_unit", cand.uuid, chosenSlot)
            end)
            task.wait(0.2)
        end
    end
end

function FarmService:IsPointInRoad(pos, margin)
    margin = margin or 1.2
    local roadFolder = workspace:FindFirstChild("_road")
    if not roadFolder then
        return false
    end
    for _, part in ipairs(roadFolder:GetDescendants()) do
        if part:IsA("BasePart") then
            local rel = part.CFrame:PointToObjectSpace(pos)
            local half = part.Size * 0.5
            if math.abs(rel.X) <= (half.X + margin)
                and math.abs(rel.Z) <= (half.Z + margin)
                and math.abs(rel.Y) <= (half.Y + 6) then
                return true
            end
        end
    end
    return false
end

function FarmService:GetLaneWaypoints()
    local bases = workspace:FindFirstChild("_BASES")
    local pveBase = bases and bases:FindFirstChild("pve")
    local lanes = pveBase and pveBase:FindFirstChild("LANES")
    local lane1 = lanes and (lanes:FindFirstChild("1") or lanes:GetChildren()[1])
    if not lane1 then
        return {}
    end

    local waypoints = {}
    local spawnPart = lane1:FindFirstChild("spawn")
    if spawnPart and spawnPart:IsA("BasePart") then
        table.insert(waypoints, spawnPart.Position)
    end
    for idx = 1, 16 do
        local p = lane1:FindFirstChild(tostring(idx))
        if p and p:IsA("BasePart") then
            table.insert(waypoints, p.Position)
        end
    end
    local finalPart = lane1:FindFirstChild("final")
    if finalPart and finalPart:IsA("BasePart") then
        table.insert(waypoints, finalPart.Position)
    end
    return waypoints
end

function FarmService:BuildPlacementSpots(isHillUnit, isHybridUnit, unitId, mode)
    mode = mode or "main"
    local cacheKey = string.format("%s:%s:%s", (isHillUnit and "hill") or (isHybridUnit and "hybrid") or "ground", tostring(unitId or "any"), mode)
    if self._spotCache and self._spotCache[cacheKey] and #self._spotCache[cacheKey] > 0 then
        return self._spotCache[cacheKey]
    end
    self._spotCache = self._spotCache or {}

    local terrainFolder = workspace:FindFirstChild("_terrain")
    local groundFolder = terrainFolder and terrainFolder:FindFirstChild("ground")
    local hillFolder = terrainFolder and terrainFolder:FindFirstChild("hill")
    local baseTerrain = terrainFolder and terrainFolder:FindFirstChild("terrain")
    if not terrainFolder or (not groundFolder and not hillFolder) then
        return {}
    end

    local waypoints = self:GetLaneWaypoints()
    if #waypoints < 2 then
        return {}
    end

    if GameModules.PlacementCore and type(GameModules.PlacementCore.init_on_map_made) == "function" then
        pcall(function()
            GameModules.PlacementCore.init_on_map_made()
        end)
    end

    local whitelist = {}
    if groundFolder then table.insert(whitelist, groundFolder) end
    if hillFolder then table.insert(whitelist, hillFolder) end
    if baseTerrain then table.insert(whitelist, baseTerrain) end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Whitelist
    rayParams.FilterDescendantsInstances = whitelist

    local nWp = #waypoints
    local totalSegs = nWp - 1
    local sampleStart = 1
    local sampleEnd = math.min(totalSegs, math.max(3, totalSegs - 2))
    local boxWpStart = 1
    local boxWpEnd = math.min(nWp, math.max(4, nWp - 3))
    local boxPad = 14.0

    if mode == "late" and totalSegs >= 3 then
        sampleStart = math.max(1, totalSegs - 2)
        sampleEnd = totalSegs
        boxWpStart = math.max(1, nWp - 2)
        boxWpEnd = nWp
        boxPad = 24.0
    end

    local pathSamples = {}
    for s = sampleStart, sampleEnd do
        local a, b = waypoints[s], waypoints[s + 1]
        local dist = (b - a).Magnitude
        local steps = math.max(1, math.floor(dist / 1.0))
        for k = 1, steps do
            table.insert(pathSamples, { pos = a:Lerp(b, k / steps), seg = s })
        end
    end

    local minX, maxX = math.huge, -math.huge
    local minZ, maxZ = math.huge, -math.huge
    local refY = waypoints[1].Y
    for i = boxWpStart, boxWpEnd do
        local p = waypoints[i]
        if p.X < minX then minX = p.X end
        if p.X > maxX then maxX = p.X end
        if p.Z < minZ then minZ = p.Z end
        if p.Z > maxZ then maxZ = p.Z end
        refY = p.Y
    end
    minX = minX - boxPad
    maxX = maxX + boxPad
    minZ = minZ - boxPad
    maxZ = maxZ + boxPad

    local spots = {}
    local rangeScale = 0.9
    pcall(function()
        local mods = workspace:FindFirstChild("_DATA") and workspace._DATA:FindFirstChild("LevelModifiers")
        local rScaleVal = mods and mods:FindFirstChild("player_range_scale")
        if rScaleVal and tonumber(rScaleVal.Value) and tonumber(rScaleVal.Value) > 0 then
            rangeScale = tonumber(rScaleVal.Value)
        end
    end)

    local def = unitId and GameModules.Units and GameModules.Units[unitId] or nil
    local baseRangeRaw = (def and tonumber(def.range)) or 20
    local maxRangeRaw = baseRangeRaw
    if def and type(def.upgrade) == "table" then
        for _, upg in ipairs(def.upgrade) do
            local r = tonumber(upg.range)
            if r and r > maxRangeRaw then
                maxRangeRaw = r
            end
        end
    end

    local baseR = baseRangeRaw * rangeScale
    local maxR = maxRangeRaw * rangeScale
    local rSqBase = math.max(2.0, baseR - 0.3) ^ 2
    local rSqMax = math.max(2.0, maxR - 0.3) ^ 2
    local maxRoadDist = math.max(3.8, baseR - 0.6)
    local minBaseScore = math.min(6, math.max(3, math.floor(baseR)))
    local gridStep = (baseR <= 10.0) and 2.0 or 2.4

    local x = minX
    while x <= maxX do
        local z = minZ
        while z <= maxZ do
            local hit = workspace:Raycast(Vector3.new(x, refY + 45, z), Vector3.new(0, -95, 0), rayParams)
            if hit and hit.Instance and hit.Instance.Name ~= "_donotplace" then
                local validSurface = false
                if isHillUnit then
                    validSurface = (hillFolder ~= nil and hit.Instance:IsDescendantOf(hillFolder))
                elseif isHybridUnit then
                    validSurface = (groundFolder ~= nil and hit.Instance:IsDescendantOf(groundFolder))
                        or (hillFolder ~= nil and hit.Instance:IsDescendantOf(hillFolder))
                else
                    validSurface = (groundFolder ~= nil and hit.Instance:IsDescendantOf(groundFolder))
                end

                if validSurface and not self:IsPointInRoad(hit.Position, 1.3) then
                    local scoreBase = 0
                    local scoreMax = 0
                    local nearestPt = waypoints[boxWpStart]
                    local nearestDSq = math.huge
                    for _, sp in ipairs(pathSamples) do
                        local dx = sp.pos.X - hit.Position.X
                        local dz = sp.pos.Z - hit.Position.Z
                        local dSq = dx * dx + dz * dz
                        if dSq < nearestDSq then
                            nearestDSq = dSq
                            nearestPt = sp.pos
                        end
                        if dSq <= rSqBase then scoreBase = scoreBase + 1 end
                        if dSq <= rSqMax then scoreMax = scoreMax + 1 end
                    end

                    local nearestDist = math.sqrt(nearestDSq)
                    if nearestDist <= maxRoadDist and scoreBase >= minBaseScore then
                        local flatToRoad = Vector3.new(nearestPt.X - hit.Position.X, 0, nearestPt.Z - hit.Position.Z)
                        local lookVec = (flatToRoad.Magnitude > 0.05) and flatToRoad.Unit or Vector3.new(0, 0, -1)
                        local cf = nil
                        if GameModules.Util and type(GameModules.Util.CFramePLV) == "function" then
                            cf = GameModules.Util.CFramePLV(hit.Position, lookVec)
                        else
                            cf = CFrame.lookAt(hit.Position, hit.Position + lookVec, Vector3.new(0, 1, 0))
                        end

                        local canPlace = true
                        if unitId and GameModules.PlacementCore and type(GameModules.PlacementCore.can_place) == "function" then
                            local okP, resP = pcall(GameModules.PlacementCore.can_place, unitId, cf, true, false)
                            if okP and not resP then
                                canPlace = false
                            end
                        end

                        if canPlace then
                            table.insert(spots, {
                                pos = hit.Position,
                                lookVec = lookVec,
                                score = scoreBase * 3 + scoreMax * 2,
                                lenStuds = scoreMax,
                                baseStuds = scoreBase,
                            })
                        end
                    end
                end
            end
            z = z + gridStep
        end
        x = x + gridStep
    end

    table.sort(spots, function(a, b)
        return a.score > b.score
    end)

    self._spotCache[cacheKey] = spots
    log(string.format("Built %d valid %s placement spots (T0=%d studs, Max=%d studs)",
        #spots, cacheKey, spots[1] and spots[1].baseStuds or 0, spots[1] and spots[1].lenStuds or 0))
    return spots
end

function FarmService:GetAliveEnemies()
    local unitsFolder = workspace:FindFirstChild("_UNITS")
    if not unitsFolder then
        return {}
    end

    local cs = game:GetService("CollectionService")
    local enemies = {}
    for _, model in ipairs(unitsFolder:GetChildren()) do
        local stats = model:FindFirstChild("_stats")
        if stats then
            local ownerVal = stats:FindFirstChild("player")
            local stateVal = stats:FindFirstChild("state")
            local hpVal = stats:FindFirstChild("health") or stats:FindFirstChild("hp")
            local maxHpVal = stats:FindFirstChild("base_health") or stats:FindFirstChild("max_hp")
            local bendVal = stats:FindFirstChild("last_reached_bend")
            local isDying = cs:HasTag(model, "dying_units") or (stateVal and stateVal.Value == "dead")
            local isEnemy = (ownerVal == nil or ownerVal.Value == nil)
            local hp = (hpVal and tonumber(hpVal.Value)) or 0
            if not isDying and isEnemy and hp > 0 then
                local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                if root and root:IsA("BasePart") then
                    local bendName = (bendVal and bendVal.Value and bendVal.Value.Name) or "spawn"
                    local bendNum = tonumber(bendName) or (bendName == "final" and 99 or 0)
                    table.insert(enemies, {
                        model = model,
                        pos = root.Position,
                        hp = hp,
                        max_hp = (maxHpVal and tonumber(maxHpVal.Value)) or hp,
                        bendName = bendName,
                        bendNum = bendNum,
                    })
                end
            end
        end
    end

    return enemies
end

function FarmService:GetMySpawnedUnits()
    local unitsFolder = workspace:FindFirstChild("_UNITS")
    if not unitsFolder then
        return {}, {}
    end

    local waypoints = self:GetLaneWaypoints()
    local finalPos = (#waypoints > 0) and waypoints[#waypoints] or nil
    local localPlayer = Players.LocalPlayer
    local cs = game:GetService("CollectionService")
    local list = {}
    local countByUnitId = {}

    for _, model in ipairs(unitsFolder:GetChildren()) do
        local stats = model:FindFirstChild("_stats")
        if stats then
            local ownerVal = stats:FindFirstChild("player")
            local stateVal = stats:FindFirstChild("state")
            local idVal = stats:FindFirstChild("id")
            local uuidVal = stats:FindFirstChild("uuid")
            local upgVal = stats:FindFirstChild("upgrade")
            local rangeVal = stats:FindFirstChild("range")
            local isDying = cs:HasTag(model, "dying_units") or (stateVal and stateVal.Value == "dead")
            if not isDying and ownerVal and ownerVal.Value == localPlayer and idVal then
                local uId = tostring(idVal.Value)
                local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                local pos = (root and root:IsA("BasePart")) and root.Position or nil
                local isLate = false
                if pos and finalPos then
                    local dFinal = Vector3.new(pos.X - finalPos.X, 0, pos.Z - finalPos.Z).Magnitude
                    isLate = (dFinal <= 45.0)
                end
                local liveRange = (rangeVal and tonumber(rangeVal.Value)) or 20.0
                countByUnitId[uId] = (countByUnitId[uId] or 0) + 1
                table.insert(list, {
                    model = model,
                    unit_id = uId,
                    uuid = uuidVal and tostring(uuidVal.Value) or "",
                    upgrade = (upgVal and tonumber(upgVal.Value)) or 0,
                    range = liveRange,
                    pos = pos,
                    isLate = isLate,
                })
            end
        end
    end

    return list, countByUnitId
end

function FarmService:IsSpotOccupiedByUnit(pos, minDist)
    minDist = minDist or 2.2
    local minDistSq = minDist * minDist
    local unitsFolder = workspace:FindFirstChild("_UNITS")
    if not unitsFolder then
        return false
    end
    for _, model in ipairs(unitsFolder:GetChildren()) do
        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if root and root:IsA("BasePart") then
            local dx = root.Position.X - pos.X
            local dz = root.Position.Z - pos.Z
            if (dx * dx + dz * dz) < minDistSq then
                return true
            end
        end
    end
    return false
end

function FarmService:GetEquippedTeamList()
    local session = GameModules.Session
    local unitsData = GameModules.Units
    if not session or not session.collection or not unitsData then
        return {}
    end

    local cpd = session.collection.collection_profile_data
    local equipped = cpd and cpd.equipped_units
    local owned = cpd and cpd.owned_units
    if type(equipped) ~= "table" or type(owned) ~= "table" then
        return {}
    end

    local list = {}
    for slotKey, uuid in pairs(equipped) do
        local unitObj = owned[uuid]
        if type(unitObj) == "table" and unitObj.unit_id then
            local def = unitsData[unitObj.unit_id]
            if def and not def._NO_ATTACKS_UNIT then
                local rRank = FARM_RARITY_RANK[def.rarity or "Common"] or 1
                table.insert(list, {
                    slot = tonumber(slotKey) or 9,
                    uuid = uuid,
                    unit_id = unitObj.unit_id,
                    unitObj = unitObj,
                    def = def,
                    rRank = rRank,
                    cost = tonumber(def.cost) or 300,
                    spawn_cap = tonumber(def.spawn_cap) or 4,
                })
            end
        end
    end

    table.sort(list, function(a, b)
        if a.rRank ~= b.rRank then return a.rRank > b.rRank end
        if a.cost ~= b.cost then return a.cost < b.cost end
        return a.slot < b.slot
    end)

    return list
end

function FarmService:StepAutoPlaceAndUpgrade()
    if not Config.AutoPlaceAndUpgrade then
        return
    end

    local localPlayer = Players.LocalPlayer
    local pStats = localPlayer and localPlayer:FindFirstChild("_stats")
    local resVal = pStats and pStats:FindFirstChild("resource")
    local currentYen = (resVal and tonumber(resVal.Value)) or 0
    if currentYen <= 0 then
        return
    end

    local session = GameModules.Session
    local unitCore = GameModules.UnitServiceCore
    local unitsData = GameModules.Units
    if not unitsData then
        return
    end

    self._rejectedSpots = self._rejectedSpots or {}
    local waveNum = (workspace:FindFirstChild("_wave_num") and tonumber(workspace._wave_num.Value)) or 0
    if waveNum <= 1 then
        self._desiredLateUnits = 0
    end

    local waypoints = self:GetLaneWaypoints()
    local nWp = #waypoints
    local leakBendThreshold = math.max(6, nWp - 3) -- On Namek (12 wps): bend >= 9 is the final straight

    local myUnits, countByUnitId = self:GetMySpawnedUnits()
    local equippedList = self:GetEquippedTeamList()

    local mainUnits = {}
    local lateUnits = {}
    for _, u in ipairs(myUnits) do
        if u.isLate then
            table.insert(lateUnits, u)
        else
            table.insert(mainUnits, u)
        end
    end

    -- 0. Dynamic Leak & Boss Catch-Up:
    -- Check if any alive enemy has leaked past all [main] units onto the final straight (bendNum >= leakBendThreshold).
    local enemies = self:GetAliveEnemies()
    local leakedCount = 0
    local enemiesInMain = 0
    for _, e in ipairs(enemies) do
        local inRangeOfMain = false
        for _, mu in ipairs(mainUnits) do
            if mu.pos then
                local d = Vector3.new(e.pos.X - mu.pos.X, 0, e.pos.Z - mu.pos.Z).Magnitude
                local uRange = (mu.range or 20.0) + 0.5
                if d <= uRange then
                    inRangeOfMain = true
                    break
                end
            end
        end
        if not inRangeOfMain and e.bendNum >= leakBendThreshold then
            leakedCount = leakedCount + 1
        elseif inRangeOfMain or e.bendNum < leakBendThreshold then
            enemiesInMain = enemiesInMain + 1
        end
    end

    if leakedCount > 0 then
        if enemiesInMain == 0 and waveNum >= 14 then
            -- Entire final wave/boss has passed [main] -> move all units to [late]
            self._desiredLateUnits = 6
        else
            -- Some enemies leaked while others are still in [main] -> station 3 units at [late]
            self._desiredLateUnits = math.max(self._desiredLateUnits or 0, 3)
        end
    elseif enemiesInMain > 0 and waveNum < 14 and #lateUnits > 0 and leakedCount == 0 then
        self._desiredLateUnits = 0
    end

    local desiredLate = self._desiredLateUnits or 0
    if desiredLate > #lateUnits and #mainUnits > 0 and currentYen >= 1400 then
        -- If we are at spawn_cap, sell 1 [main] unit (preferring one with no nearby enemies) so we can re-place it at [late]
        local totalCap = 0
        for _, eq in ipairs(equippedList) do totalCap = totalCap + eq.spawn_cap end
        if #myUnits >= math.min(totalCap, 6) then
            local unitToSell = mainUnits[#mainUnits]
            log(string.format("Relocating %s from [main] to [late] (leaked=%d, inMain=%d, late=%d/%d)",
                unitToSell.unit_id, leakedCount, enemiesInMain, #lateUnits, desiredLate))
            pcall(function()
                GameModules:InvokeServer("sell_unit_ingame", unitToSell.model)
            end)
            return
        end
    end

    local spotMode = (#lateUnits < desiredLate) and "late" or "main"

    -- 1. Place equipped units up to their spawn_cap
    local waitingForPlace = false
    for _, eq in ipairs(equippedList) do
        local currentCount = countByUnitId[eq.unit_id] or 0
        if currentCount < eq.spawn_cap then
            local spawnMul = 1
            if unitCore and session and type(unitCore.calculate_spawn_cost_multiplier) == "function" then
                local okM, m = pcall(unitCore.calculate_spawn_cost_multiplier, session)
                if okM and type(m) == "number" then spawnMul = m end
            end
            local spawnCost = math.ceil(eq.cost * spawnMul)
            local spots = self:BuildPlacementSpots(eq.def.hill_unit == true, eq.def.hybrid_placement == true, eq.unit_id, spotMode)

            local foundFreeSpot = nil
            local foundSpotIdx = nil
            for idx, spot in ipairs(spots) do
                local rejectKey = string.format("%s:%s:%d", tostring(eq.unit_id), spotMode, idx)
                if not self._rejectedSpots[rejectKey] and not self:IsSpotOccupiedByUnit(spot.pos, 2.2) then
                    foundFreeSpot = spot
                    foundSpotIdx = idx
                    break
                end
            end

            if foundFreeSpot then
                if currentYen >= spawnCost then
                    local cf = nil
                    if GameModules.Util and type(GameModules.Util.CFramePLV) == "function" then
                        cf = GameModules.Util.CFramePLV(foundFreeSpot.pos, foundFreeSpot.lookVec)
                    else
                        cf = CFrame.lookAt(foundFreeSpot.pos, foundFreeSpot.pos + foundFreeSpot.lookVec, Vector3.new(0, 1, 0))
                    end

                    local placedOk = false
                    pcall(function()
                        placedOk = GameModules:InvokeServer("spawn_unit", eq.uuid, cf) == true
                    end)

                    if placedOk then
                        log(string.format("Placed unit %s (%d/%d) [%s] at (%.1f, %.1f, %.1f) cov=%d cost=%d",
                            eq.unit_id, currentCount + 1, eq.spawn_cap, spotMode,
                            foundFreeSpot.pos.X, foundFreeSpot.pos.Y, foundFreeSpot.pos.Z,
                            foundFreeSpot.lenStuds or 0, spawnCost))
                        return
                    else
                        local rejectKey = string.format("%s:%s:%d", tostring(eq.unit_id), spotMode, foundSpotIdx)
                        self._rejectedSpots[rejectKey] = true
                    end
                else
                    waitingForPlace = true
                    break
                end
            end
        end
    end

    -- 2. Upgrade spawned units (prioritize [late] catch-up units first when active, then lowest upgrade tier)
    if not waitingForPlace and #myUnits > 0 then
        table.sort(myUnits, function(a, b)
            if desiredLate > 0 and a.isLate ~= b.isLate then
                return a.isLate
            end
            if a.upgrade ~= b.upgrade then
                return a.upgrade < b.upgrade
            end
            local defA = unitsData[a.unit_id]
            local defB = unitsData[b.unit_id]
            local rA = FARM_RARITY_RANK[defA and defA.rarity or "Common"] or 1
            local rB = FARM_RARITY_RANK[defB and defB.rarity or "Common"] or 1
            return rA > rB
        end)

        for _, u in ipairs(myUnits) do
            local def = unitsData[u.unit_id]
            local upgTable = def and def.upgrade
            local nextUpg = (type(upgTable) == "table") and upgTable[u.upgrade + 1] or nil
            if nextUpg and nextUpg.cost then
                local upgMul = 1
                if unitCore and session and type(unitCore.calculate_upgrade_cost_multiplier) == "function" then
                    local okM, m = pcall(unitCore.calculate_upgrade_cost_multiplier, u.model, session)
                    if okM and type(m) == "number" then upgMul = m end
                end
                local upgCost = math.ceil(tonumber(nextUpg.cost) * upgMul)
                if currentYen >= upgCost then
                    local upgOk = false
                    pcall(function()
                        upgOk = GameModules:InvokeServer("upgrade_unit_ingame", u.model) == true
                    end)
                    if upgOk then
                        log(string.format("Upgraded %s [%s] to tier %d/%d (cost=%d)",
                            u.unit_id, u.isLate and "late" or "main", u.upgrade + 1, #upgTable, upgCost))
                        break
                    end
                else
                    break
                end
            end
        end
    end

    -- 3. Trigger Active Attacks if off cooldown
    local nowTick = tick()
    for _, u in ipairs(myUnits) do
        local stats = u.model:FindFirstChild("_stats")
        local activeVal = stats and stats:FindFirstChild("active_attack")
        local cdVal = stats and stats:FindFirstChild("active_attack_cooldown")
        local lastCastVal = stats and stats:FindFirstChild("last_active_cast")
        if activeVal and activeVal.Value ~= "" and activeVal.Value ~= "nil" and cdVal and lastCastVal then
            if (cdVal.Value - (nowTick - lastCastVal.Value)) <= 0 then
                pcall(function()
                    GameModules:InvokeServer("use_active_attack", u.model)
                end)
            end
        end
    end
end

function FarmService:IsStoryLevelCompleted(levelId)
    local pData = (GameModules.Session and GameModules.Session.profile_data)
        or (GameModules.StatsServiceClient and GameModules.StatsServiceClient.session and GameModules.StatsServiceClient.session.profile_data)
    local completed = pData and pData.level_data and pData.level_data.completed_story_levels
    local entry = type(completed) == "table" and completed[levelId] or nil
    return type(entry) == "table" and (tonumber(entry.times_completed) or 0) > 0
end

function FarmService:GetDesiredStoryStage(worldId)
    worldId = worldId or Config.FarmWorld or "namek"
    local replayStage = Config.FarmLevel or (worldId .. "_level_1")
    if Config.ClearWorldActsFirst ~= false then
        for act = 1, 6 do
            local stageId = string.format("%s_level_%d", worldId, act)
            if not self:IsStoryLevelCompleted(stageId) then
                return stageId, true
            end
        end
    end
    return replayStage, false
end

function FarmService:GetPostMatchAction(isVictory)
    local currentLevel = GameModules:GetPlayerLevel()
    local targetLevel = tonumber(Config.TargetFarmLevel) or 20
    if not Config.AutoFarmEnabled or currentLevel >= targetLevel then
        return "lobby", "target_level_reached"
    end

    local worldId = Config.FarmWorld or "namek"
    local replayStage = Config.FarmLevel or (worldId .. "_level_1")
    local curStageId = GameModules.Loader and GameModules.Loader.LevelData and GameModules.Loader.LevelData.id or nil

    if not isVictory then
        return "replay", "retry_defeat"
    end

    local curWorld, curActStr = string.match(tostring(curStageId or ""), "^([%w_]+)_level_(%d+)$")
    local curAct = tonumber(curActStr)

    if Config.ClearWorldActsFirst ~= false and curWorld == worldId and curAct then
        if curAct < 6 then
            for nextAct = curAct + 1, 6 do
                local nextStageId = string.format("%s_level_%d", worldId, nextAct)
                if not self:IsStoryLevelCompleted(nextStageId) then
                    if nextAct == curAct + 1 then
                        return "next_story", nextStageId
                    else
                        return "lobby", "select_" .. nextStageId
                    end
                end
            end
            -- All subsequent acts (curAct+1 .. 6) are already completed!
            if curStageId ~= replayStage then
                return "lobby", "return_to_" .. replayStage
            end
        elseif curAct >= 6 then
            if curStageId ~= replayStage then
                return "lobby", "finished_act6_return_to_" .. replayStage
            end
        end
    elseif curStageId and curStageId ~= replayStage then
        return "lobby", "switch_to_" .. replayStage
    end

    return "replay", curStageId or replayStage
end

function FarmService:EnterStoryMatch()
    if not GameModules.Loader or not GameModules.Loader.IsLobby then
        return false
    end

    local playerLevel = GameModules:GetPlayerLevel()
    local targetLevel = tonumber(Config.TargetFarmLevel) or 20
    log(string.format("Player Level (%d) < TargetFarmLevel (%d), entering Story match", playerLevel, targetLevel))

    local targetWorld = Config.FarmWorld or "namek"
    local difficulty = Config.FarmDifficulty or "Normal"
    local localPlayer = Players.LocalPlayer
    local attempt = 0

    while self:ShouldFarm() and GameModules.Loader and GameModules.Loader.IsLobby do
        attempt = attempt + 1

        -- 1. Ensure at least 1 unit is equipped (server rejects lock/start if 0 equipped)
        self:EquipBestTeam()
        local session = GameModules.Session
        local eqSlots = session and session.collection and session.collection:get_used_equipped_slots() or 0
        if eqSlots == 0 and JoinStart and JoinStart.EnsureStarterUnitEquipped then
            JoinStart:EnsureStarterUnitEquipped()
        end

        -- 2. Clear any stale lobby state if AlreadyInLobby is stuck
        self:LeaveOwnedStoryLobbies()

        local targetStage, isFirstClearProgression = self:GetDesiredStoryStage(targetWorld)
        local lobbyModel = self:FindEmptyStoryLobby()

        if lobbyModel then
            log(string.format("Joining Story lobby: %s -> %s (mode=%s, Attempt %d)",
                lobbyModel.Name, targetStage, isFirstClearProgression and "FirstClearAct1..6" or "ReplayAct1", attempt))

            local joined = false
            pcall(function()
                joined = GameModules:InvokeServer("request_join_lobby", lobbyModel.Name) == true
            end)

            local isOwner = lobbyModel:FindFirstChild("Owner") and lobbyModel.Owner.Value == localPlayer
            if joined and isOwner then
                task.wait(0.2)

                -- Close any World Skip UI popup if open
                local guiService = GameModules.GUIService
                if guiService and guiService.notification_windows_ui then
                    pcall(function()
                        guiService.notification_windows_ui:hide()
                    end)
                end

                -- Optional World Skip (only if explicitly enabled AND ClearWorldActsFirst is false)
                if Config.UseWorldSkip and Config.ClearWorldActsFirst == false then
                    log(string.format("Invoking lobby_world_skip('%s') for instant match start", targetWorld))
                    pcall(function()
                        GameModules:InvokeServer("lobby_world_skip", targetWorld)
                    end)
                    task.wait(1.5)
                end

                -- 3. Lock desired stage; if rejected, walk backwards Act N -> Act 1 to find highest unlocked stage
                local locked = false
                local lockedStage = targetStage
                pcall(function()
                    locked = GameModules:InvokeServer("request_lock_level", lobbyModel.Name, targetStage, true, difficulty) == true
                end)

                if not locked then
                    local curW, curActStr = string.match(tostring(targetStage), "^([%w_]+)_level_(%d+)$")
                    local startAct = (tonumber(curActStr) or 6) - 1
                    local worldPrefix = curW or targetWorld
                    for fallbackAct = startAct, 1, -1 do
                        local fallbackStage = string.format("%s_level_%d", worldPrefix, fallbackAct)
                        pcall(function()
                            locked = GameModules:InvokeServer("request_lock_level", lobbyModel.Name, fallbackStage, true, difficulty) == true
                        end)
                        if locked then
                            lockedStage = fallbackStage
                            log(string.format("Fallback locked highest unlocked stage: %s", lockedStage))
                            break
                        end
                    end
                end

                if locked then
                    task.wait(0.2)
                    log(string.format("Starting Story match (%s) via request_start_game", tostring(lockedStage)))
                    pcall(function()
                        GameModules:InvokeServer("request_start_game", lobbyModel.Name)
                    end)

                    -- 4. Wait up to 15s for Roblox teleport to occur; if TeleportService drops/fails, leave pod and retry!
                    local waitStart = os.clock()
                    while os.clock() - waitStart < 15 do
                        task.wait(0.5)
                        if not GameModules.Loader or not GameModules.Loader.IsLobby then
                            return true
                        end
                    end
                    warn("[Main] Teleport did not complete within 15s, leaving lobby pod and retrying")
                else
                    warn(string.format("[Main] request_lock_level failed on %s, leaving pod and retrying", lobbyModel.Name))
                end

                pcall(function()
                    GameModules:InvokeServer("request_leave_lobby", lobbyModel.Name)
                end)
            elseif joined and not isOwner then
                pcall(function()
                    GameModules:InvokeServer("request_leave_lobby", lobbyModel.Name)
                end)
            end
        end

        task.wait(1.5)
    end

    return true
end

function FarmService:EnableAutoSkipSetting()
    if not Config.AutoSkipWaves then
        return
    end

    local player = Players.LocalPlayer
    local settingsFolder = player and player:FindFirstChild("_settings")
    local autoSkipVal = settingsFolder and settingsFolder:FindFirstChild("autoskip_waves")
    if autoSkipVal then
        pcall(function()
            autoSkipVal.Value = true
            GameModules:InvokeServer("toggle_setting", "autoskip_waves", true)
        end)
        log("Enabled autoskip_waves setting (Always True)")
    end

    local guiService = GameModules.GUIService
    local voteWaveUI = guiService and guiService.vote_wave_ui
    if voteWaveUI and not self.VoteSkipHooked then
        if not voteWaveUI._orig_on_start_vote_wave_skip then
            voteWaveUI._orig_on_start_vote_wave_skip = voteWaveUI.on_start_vote_wave_skip
        end
        voteWaveUI.on_start_vote_wave_skip = function(uiSelf, ...)
            if Config.AutoSkipWaves then
                local p = Players.LocalPlayer
                if p and p:FindFirstChild("_settings") and p._settings:FindFirstChild("autoskip_waves") then
                    p._settings.autoskip_waves.Value = true
                end
                task.spawn(function()
                    pcall(function()
                        GameModules:InvokeServer("vote_wave_skip")
                    end)
                end)
            end
            return voteWaveUI._orig_on_start_vote_wave_skip(uiSelf, ...)
        end
        self.VoteSkipHooked = true
    end
end

function FarmService:RunInGame()
    if GameModules.Loader and GameModules.Loader.IsLobby then
        return
    end
    if self.Running then
        return
    end

    self.Running = true
    log("Starting In-Game Auto Place & Win Farm loop")
    self._spotCache = {}
    self._rejectedSpots = {}
    self._desiredLateUnits = 0
    if GameModules.PlacementCore and type(GameModules.PlacementCore.init_on_map_made) == "function" then
        pcall(function()
            GameModules.PlacementCore.init_on_map_made()
        end)
    end
    self:EnableAutoSkipSetting()
    self:HookVoteStartUI()
    self:TriggerVoteStart()

    task.spawn(function()
        local lastVoteStart = 0
        local lastVoteSkip = 0
        local lastPlaceStep = 0
        local lastReplayVote = 0
        local placeBusyUntil = 0
        local handledResultsForMatch = false
        local lastRematchLoadingId = GameModules.RematchServiceClient and GameModules.RematchServiceClient.loading_id or 0

        while self.Running do
            local guiService = GameModules.GUIService
            local dataFolder = workspace:FindFirstChild("_DATA")
            local gameStarted = dataFolder and dataFolder:FindFirstChild("GameStarted") and dataFolder.GameStarted.Value
            local gameFinished = dataFolder and dataFolder:FindFirstChild("GameFinished") and dataFolder.GameFinished.Value
            local voteStartFolder = dataFolder and dataFolder:FindFirstChild("VoteStart")
            local votingFinished = voteStartFolder and voteStartFolder:FindFirstChild("VotingFinished") and voteStartFolder.VotingFinished.Value
            local rematchActive = GameModules.RematchServiceClient and GameModules.RematchServiceClient.active
            local curLoadingId = GameModules.RematchServiceClient and GameModules.RematchServiceClient.loading_id or 0

            if curLoadingId ~= lastRematchLoadingId and not rematchActive then
                lastRematchLoadingId = curLoadingId
                handledResultsForMatch = false
                placeBusyUntil = 0
                self._rejectedSpots = {}
                self._desiredLateUnits = 0
                if GameModules.PlacementCore and type(GameModules.PlacementCore.init_on_map_made) == "function" then
                    pcall(function()
                        GameModules.PlacementCore.init_on_map_made()
                    end)
                end
            end

            -- 1. Vote Start before match begins (and dismiss VoteStart UI if shown)
            if Config.AutoVoteStart and not rematchActive and not gameFinished then
                local startVoteUI = guiService and guiService.start_vote_ui
                local uiShown = startVoteUI and startVoteUI.screenGUI and startVoteUI.screenGUI.Enabled
                if (not gameStarted and not votingFinished) or uiShown then
                    if os.clock() - lastVoteStart >= 0.4 then
                        lastVoteStart = os.clock()
                        task.spawn(function()
                            self:TriggerVoteStart()
                        end)
                    end
                end
            end

            -- 2. Wave Skip (Always True in settings + instant vote_wave_skip on all waves 1..15)
            if Config.AutoSkipWaves and gameStarted and not gameFinished then
                local p = Players.LocalPlayer
                if p and p:FindFirstChild("_settings") and p._settings:FindFirstChild("autoskip_waves") then
                    if not p._settings.autoskip_waves.Value then
                        p._settings.autoskip_waves.Value = true
                        pcall(function()
                            GameModules:InvokeServer("toggle_setting", "autoskip_waves", true)
                        end)
                    end
                end

                local voteWaveUI = guiService and guiService.vote_wave_ui
                if voteWaveUI and voteWaveUI.screenGUI and voteWaveUI.screenGUI.Enabled then
                    if os.clock() - lastVoteSkip >= 0.3 then
                        lastVoteSkip = os.clock()
                        task.spawn(function()
                            pcall(function()
                                if GameModules:InvokeServer("vote_wave_skip") then
                                    voteWaveUI.screenGUI.Enabled = false
                                end
                            end)
                        end)
                    end
                end
            end

            -- 2.5 Auto Place & Auto Upgrade equipped units during active match
            if Config.AutoPlaceAndUpgrade and gameStarted and not gameFinished and os.clock() >= placeBusyUntil then
                if os.clock() - lastPlaceStep >= 0.18 then
                    lastPlaceStep = os.clock()
                    placeBusyUntil = os.clock() + 2.0
                    task.spawn(function()
                        pcall(function()
                            self:StepAutoPlaceAndUpgrade()
                        end)
                        placeBusyUntil = 0
                    end)
                end
            end

            -- 3. Handle match finish (non-blocking replay vote; never call show_unit_and_item_rewards which yields on BindableEvent)
            local resultsUI = guiService and guiService.results_ui
            local resultsShown = resultsUI and resultsUI.screenGUI and resultsUI.screenGUI.Enabled
            if gameFinished or resultsShown then
                if resultsShown then
                    pcall(function()
                        resultsUI.Holder.Visible = false
                        resultsUI.BG.Visible = false
                        resultsUI._show_finished = true
                        if resultsUI.Finished then
                            resultsUI.Finished.Visible = true
                        end
                    end)
                end

                if not handledResultsForMatch then
                    handledResultsForMatch = true
                    lastReplayVote = os.clock()
                    placeBusyUntil = 0
                    task.wait(0.35)

                    local isVictory = false
                    if resultsUI and resultsUI.settings and resultsUI.settings.victory ~= nil then
                        isVictory = (resultsUI.settings.victory == true)
                    else
                        local baseHum = workspace:FindFirstChild("_BASES")
                            and workspace._BASES:FindFirstChild("player")
                            and workspace._BASES.player:FindFirstChild("base")
                            and workspace._BASES.player.base:FindFirstChild("fake_unit")
                            and workspace._BASES.player.base.fake_unit:FindFirstChildOfClass("Humanoid")
                        if baseHum then
                            isVictory = (baseHum.Health > 0)
                        end
                    end
                    local resultStr = isVictory and "Victory" or "Defeat"

                    if DailyService and DailyService.ClaimCompletedQuests then
                        task.spawn(function()
                            pcall(function()
                                DailyService:ClaimCompletedQuests()
                            end)
                        end)
                    end

                    if TrackerService and TrackerService.PushFarm then
                        task.spawn(function()
                            pcall(function()
                                local waveVal = (workspace:FindFirstChild("_wave_num") and workspace._wave_num.Value)
                                    or (dataFolder and dataFolder:FindFirstChild("Wave") and dataFolder.Wave.Value)
                                    or 0
                                TrackerService:PushFarm({
                                    level = tostring(GameModules:GetPlayerLevel()),
                                    world = Config.FarmWorld or "Story",
                                    difficulty = Config.FarmDifficulty or "Normal",
                                    wave = waveVal,
                                    result = resultStr,
                                })
                            end)
                        end)
                    end

                    local currentLevel = GameModules:GetPlayerLevel()
                    local targetLevel = tonumber(Config.TargetFarmLevel) or 20
                    local currentGems = GameModules:GetGemAmount()
                    local postAction, postReason = self:GetPostMatchAction(isVictory)
                    self._lastPostAction = postAction

                    if postAction == "next_story" then
                        log(string.format("Match %s (Lv.%d/%d | Gems: %d) -> Advancing to Next Story Act (%s)",
                            resultStr, currentLevel, targetLevel, currentGems, tostring(postReason)))
                        task.spawn(function()
                            pcall(function()
                                GameModules:InvokeServer("set_game_finished_vote", "next_story")
                            end)
                        end)
                    elseif postAction == "replay" then
                        log(string.format("Match %s (Lv.%d/%d | Gems: %d) -> Voting Replay (%s)",
                            resultStr, currentLevel, targetLevel, currentGems, tostring(postReason)))
                        task.spawn(function()
                            pcall(function()
                                GameModules:InvokeServer("set_game_finished_vote", "replay")
                            end)
                        end)
                    else
                        log(string.format("Match %s (Lv.%d/%d | Gems: %d) -> Returning to Lobby (%s)",
                            resultStr, currentLevel, targetLevel, currentGems, tostring(postReason)))
                        task.spawn(function()
                            pcall(function()
                                GameModules:InvokeServer("teleport_back_to_lobby")
                            end)
                        end)
                    end
                elseif not rematchActive and (os.clock() - lastReplayVote >= 4.0) then
                    lastReplayVote = os.clock()
                    local postAction = self._lastPostAction or "replay"
                    task.spawn(function()
                        pcall(function()
                            if postAction == "next_story" then
                                GameModules:InvokeServer("set_game_finished_vote", "next_story")
                            elseif postAction == "replay" then
                                GameModules:InvokeServer("set_game_finished_vote", "replay")
                            else
                                GameModules:InvokeServer("teleport_back_to_lobby")
                            end
                        end)
                    end)
                end
            else
                if handledResultsForMatch then
                    handledResultsForMatch = false
                    placeBusyUntil = 0
                    self._rejectedSpots = {}
                    self._desiredLateUnits = 0
                    local startVoteUI = guiService and guiService.start_vote_ui
                    if startVoteUI then
                        startVoteUI.voted = false
                    end
                end
            end

            task.wait(0.15)
        end
    end)
end

-- ============================================================================
-- MODULE: AntiAfkService (Disable Roblox 20m Idle Kick + VirtualUser Fallback)
-- ============================================================================
local AntiAfkService = {
    Started = false,
    IdledConnection = nil,
}

function AntiAfkService:Start()
    if not Config.AntiAfkEnabled or self.Started then
        return false
    end

    local player = Players.LocalPlayer
    if not player then
        return false
    end

    local disabledCount = 0
    if type(getconnections) == "function" then
        pcall(function()
            for _, conn in ipairs(getconnections(player.Idled)) do
                if type(conn.Disable) == "function" then
                    conn:Disable()
                    disabledCount = disabledCount + 1
                elseif type(conn.Disconnect) == "function" then
                    conn:Disconnect()
                    disabledCount = disabledCount + 1
                end
            end
        end)
    end

    local VirtualUser = nil
    pcall(function()
        VirtualUser = game:GetService("VirtualUser")
    end)

    self.IdledConnection = player.Idled:Connect(function()
        if not Config.AntiAfkEnabled then
            return
        end
        pcall(function()
            if VirtualUser then
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            elseif VirtualInputManager then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.RightControl, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.RightControl, false, game)
            end
        end)
    end)

    self.Started = true
    log(string.format("AntiAfkService enabled (Disabled %d Idled connections + VirtualUser fallback)", disabledCount))
    return true
end

-- ============================================================================
-- MODULE: PerformanceService (Anti-Lag, Map Stripper, VFX/Unit Cleaner)
-- ============================================================================
local PerformanceService = {
    Started = false,
    Connections = {},
}

function PerformanceService:ApplyEngineAndLightingSettings()
    local Lighting = game:GetService("Lighting")
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
    end)

    for _, inst in ipairs(Lighting:GetDescendants()) do
        if inst:IsA("PostEffect") or inst:IsA("Atmosphere") or inst:IsA("Sky") or inst:IsA("Clouds") then
            pcall(function()
                if inst:IsA("PostEffect") then
                    inst.Enabled = false
                end
                inst:Destroy()
            end)
        end
    end

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    pcall(function()
        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 0
            terrain.Decoration = false
        end
    end)

    if type(Config.FpsCap) == "number" and Config.FpsCap > 0 and type(setfpscap) == "function" then
        pcall(function()
            setfpscap(Config.FpsCap)
        end)
    end

    if Config.Disable3DRenderingInMatch and GameModules.Loader and not GameModules.Loader.IsLobby then
        pcall(function()
            game:GetService("RunService"):Set3dRenderingEnabled(false)
        end)
    end
end

function PerformanceService:ApplyGameLowQualitySettings()
    if not Config.ApplyLowQualityGameSettings then
        return
    end

    local player = Players.LocalPlayer
    local settingsFolder = player and player:FindFirstChild("_settings")
    if not settingsFolder then
        return
    end

    local desiredBoolSettings = {
        low_quality = true,
        low_quality_shadows = true,
        low_quality_textures = true,
        disable_effects = true,
        disable_kill_fx = true,
        disable_other_fx = true,
        hide_other_pets = true,
        hide_damage_modifiers = true,
        dynamic_depth_of_field = false,
        show_damage_text = false,
        show_all_unit_health = false,
        show_overheads = false,
        show_other_overheads = false,
    }

    for settingName, targetVal in pairs(desiredBoolSettings) do
        local valObj = settingsFolder:FindFirstChild(settingName)
        if valObj and valObj.Value ~= targetVal then
            pcall(function()
                valObj.Value = targetVal
            end)
        end
    end

    local sliderZeros = { "game_volume", "music_volume", "lobby_music_volume" }
    for _, sliderName in ipairs(sliderZeros) do
        local valObj = settingsFolder:FindFirstChild(sliderName)
        if valObj and valObj.Value ~= 0 then
            pcall(function()
                valObj.Value = 0
            end)
        end
    end
end

function PerformanceService:HookFXServices()
    pcall(function()
        local fxService = GameModules.Loader and GameModules.Loader.load_client_service(script, "FXServiceClient")
        if fxService and not fxService._perf_hooked then
            fxService._perf_hooked = true
            fxService._start_fx = function()
                return nil
            end
            fxService.start_fx_server = function()
                return nil
            end
            fxService.start_fx_client = function()
                return nil
            end
        end
    end)

    pcall(function()
        local lightingService = GameModules.Loader and GameModules.Loader.load_client_service(script, "LightingServiceClient")
        if lightingService and not lightingService._perf_hooked then
            lightingService._perf_hooked = true
            lightingService.change_lighting = function() end
            lightingService.refresh_ = function() end
        end
    end)
end

function PerformanceService:StripInstanceVisuals(inst)
    if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") or inst:IsA("Highlight") or inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
        pcall(function()
            inst.Enabled = false
            inst:Destroy()
        end)
    elseif inst:IsA("Decal") or inst:IsA("Texture") or inst:IsA("SurfaceAppearance") then
        pcall(function()
            inst:Destroy()
        end)
    elseif inst:IsA("MeshPart") then
        pcall(function()
            inst.TextureID = ""
            inst.Material = Enum.Material.SmoothPlastic
            inst.CastShadow = false
        end)
    elseif inst:IsA("BasePart") then
        pcall(function()
            inst.Material = Enum.Material.SmoothPlastic
            inst.CastShadow = false
        end)
    elseif inst:IsA("SpecialMesh") then
        pcall(function()
            inst.TextureId = ""
        end)
    end
end

function PerformanceService:CleanMapAndTerrain()
    if not Config.RemoveMapDecorations then
        return
    end

    local isLobby = GameModules.Loader and GameModules.Loader.IsLobby
    if isLobby then
        for _, inst in ipairs(workspace:GetDescendants()) do
            self:StripInstanceVisuals(inst)
        end
        return
    end

    -- Wait until Setup.lua finishes reading _MAP_CONFIG.MapLoaded & LevelData
    local mapConfig = workspace:FindFirstChild("_MAP_CONFIG")
    local mapLoaded = mapConfig and mapConfig:FindFirstChild("MapLoaded")
    if mapLoaded and not mapLoaded.Value then
        local t0 = os.clock()
        while not mapLoaded.Value and (os.clock() - t0 < 10) do
            task.wait(0.2)
        end
    end

    local removedCount = 0

    -- 1. Clear workspace._map children (trees, grass, mushrooms, bridges, props)
    local mapFolder = workspace:FindFirstChild("_map")
    if mapFolder then
        for _, child in ipairs(mapFolder:GetChildren()) do
            pcall(function()
                child:Destroy()
                removedCount = removedCount + 1
            end)
        end
        table.insert(self.Connections, mapFolder.ChildAdded:Connect(function(child)
            task.defer(function()
                pcall(function()
                    child:Destroy()
                end)
            end)
        end))
    end

    -- 2. Clear decorative folders in workspace._terrain while keeping "ground", "hill", "terrain" for PlacementCore raycasts
    local terrainFolder = workspace:FindFirstChild("_terrain")
    if terrainFolder then
        local keepTerrainFolders = { ground = true, hill = true, terrain = true }
        for _, child in ipairs(terrainFolder:GetChildren()) do
            if not keepTerrainFolders[child.Name] then
                pcall(function()
                    child:Destroy()
                    removedCount = removedCount + 1
                end)
            else
                for _, desc in ipairs(child:GetDescendants()) do
                    self:StripInstanceVisuals(desc)
                    if desc:IsA("BasePart") then
                        desc.Transparency = 1
                        desc.CastShadow = false
                    end
                end
            end
        end
        if GameModules.PlacementCore and type(GameModules.PlacementCore.init_on_map_made) == "function" then
            pcall(function()
                GameModules.PlacementCore.init_on_map_made()
            end)
        end
    end

    -- 3. Hide _road, _water_blocks, and _BASES visuals completely (Transparency = 1) while keeping instances alive for raycasts
    for _, folderName in ipairs({ "_road", "_water_blocks", "_BASES" }) do
        local f = workspace:FindFirstChild(folderName)
        if f then
            for _, desc in ipairs(f:GetDescendants()) do
                self:StripInstanceVisuals(desc)
                if desc:IsA("BasePart") then
                    pcall(function()
                        desc.Transparency = 1
                        desc.CastShadow = false
                    end)
                end
            end
        end
    end

    -- 4. Hide LocalPlayer character parts & stop character Animator in match
    local localPlayer = Players.LocalPlayer
    if localPlayer and localPlayer.Character then
        for _, desc in ipairs(localPlayer.Character:GetDescendants()) do
            self:StripInstanceVisuals(desc)
            if desc:IsA("BasePart") then
                pcall(function()
                    desc.Transparency = 1
                    desc.CastShadow = false
                end)
            elseif desc:IsA("Animator") then
                pcall(function()
                    for _, track in ipairs(desc:GetPlayingAnimationTracks()) do
                        track:Stop(0)
                    end
                    desc:Destroy()
                end)
            end
        end
    end

    log(string.format("PerformanceService cleaned Map & Terrain (%d top-level groups removed)", removedCount))
end

function PerformanceService:StripUnitModel(unitModel)
    if not Config.StripUnitVisuals or not unitModel then
        return
    end

    task.defer(function()
        local stripChildNames = {
            ["_cell_shading"] = true,
            ["_shadow"] = true,
            ["Shirt"] = true,
            ["Pants"] = true,
            ["ShirtGraphic"] = true,
            ["BodyColors"] = true,
        }

        for _, desc in ipairs(unitModel:GetDescendants()) do
            if stripChildNames[desc.Name] or desc:IsA("Accessory") or desc:IsA("Clothing") or desc:IsA("CharacterMesh") or desc:IsA("SpecialMesh") or desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") or desc:IsA("Decal") or desc:IsA("Texture") or desc:IsA("Highlight") or desc:IsA("Animator") or desc:IsA("AnimationController") then
                pcall(function()
                    if desc:IsA("Animator") then
                        for _, track in ipairs(desc:GetPlayingAnimationTracks()) do
                            track:Stop(0)
                        end
                    end
                    desc:Destroy()
                end)
            elseif desc:IsA("BasePart") then
                pcall(function()
                    desc.Material = Enum.Material.SmoothPlastic
                    desc.CastShadow = false
                    desc.Transparency = 1
                end)
            elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
                pcall(function()
                    desc.Enabled = false
                end)
            end
        end
    end)
end

function PerformanceService:SetupUnitAndVFXCleaners()
    if GameModules.Loader and GameModules.Loader.IsLobby then
        return
    end

    -- 1. Strip spawned units in workspace._UNITS
    if Config.StripUnitVisuals then
        local unitsFolder = workspace:FindFirstChild("_UNITS")
        if unitsFolder then
            for _, unitModel in ipairs(unitsFolder:GetChildren()) do
                self:StripUnitModel(unitModel)
            end
            table.insert(self.Connections, unitsFolder.ChildAdded:Connect(function(unitModel)
                self:StripUnitModel(unitModel)
            end))
        end
    end

    -- 2. Clear BoltPart & VFX parts in CurrentCamera and workspace.ignore
    if Config.ClearCameraVFX then
        local cam = workspace.CurrentCamera
        if cam then
            for _, child in ipairs(cam:GetChildren()) do
                if child:IsA("BasePart") or child:IsA("Model") or child:IsA("Folder") then
                    pcall(function()
                        child:Destroy()
                    end)
                end
            end
            table.insert(self.Connections, cam.ChildAdded:Connect(function(child)
                if child:IsA("BasePart") or child:IsA("Model") or child:IsA("Folder") then
                    task.defer(function()
                        pcall(function()
                            child:Destroy()
                        end)
                    end)
                end
            end))
        end

        local ignoreFolder = workspace:FindFirstChild("ignore")
        if ignoreFolder then
            for _, child in ipairs(ignoreFolder:GetChildren()) do
                pcall(function()
                    child:Destroy()
                end)
            end
            table.insert(self.Connections, ignoreFolder.ChildAdded:Connect(function(child)
                task.defer(function()
                    pcall(function()
                        child:Destroy()
                    end)
                end)
            end))
        end
    end
end

function PerformanceService:Start()
    if not Config.OptimizePerformance or self.Started then
        return false
    end

    self.Started = true
    self:ApplyEngineAndLightingSettings()
    self:ApplyGameLowQualitySettings()
    self:HookFXServices()
    self:CleanMapAndTerrain()
    self:SetupUnitAndVFXCleaners()

    log("PerformanceService optimization complete")
    return true
end

-- ============================================================================
-- MODULE: KaitunUIService (Full-Screen Kaitun Dashboard Overlay based on ui.lua)
-- ============================================================================
local KaitunUIService = {
    ScreenGui = nil,
    IsHidden = false,
}

function KaitunUIService:FormatTime(seconds)
    seconds = math.max(0, tonumber(seconds) or 0)
    local hrs = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hrs, mins, secs)
end

function KaitunUIService:FormatCompactNumber(n)
    n = tonumber(n) or 0
    if n >= 1e15 then
        return string.format("%.2fQ", n / 1e15)
    elseif n >= 1e12 then
        return string.format("%.2fT", n / 1e12)
    elseif n >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.2fK", n / 1e3)
    else
        return tostring(math.floor(n))
    end
end

function KaitunUIService:FindParent()
    local guiName = "Kaitun_Dashboard_UI"
    local localPlayer = Players.LocalPlayer

    local okCg, cg = pcall(function()
        return (type(cloneref) == "function" and cloneref(game:GetService("CoreGui"))) or game:GetService("CoreGui")
    end)
    if okCg and cg then
        if cg:FindFirstChild(guiName) then
            cg[guiName]:Destroy()
        end
        return cg
    end

    local pg = localPlayer and (localPlayer:FindFirstChild("PlayerGui") or localPlayer:WaitForChild("PlayerGui", 5))
    if pg then
        if pg:FindFirstChild(guiName) then
            pg[guiName]:Destroy()
        end
        return pg
    end

    return nil
end

function KaitunUIService:GetGoldAmount()
    local ok, val = pcall(function()
        return GameModules.StatsServiceClient.stats.gold_amount.Value
    end)
    if ok and type(val) == "number" then
        return val
    end
    local session = GameModules.Session
    if session and session.profile_data and session.profile_data.resources then
        return session.profile_data.resources.gold_amount or 0
    end
    return 0
end

function KaitunUIService:GetPlayerXPProgress(level)
    local player = Players.LocalPlayer
    local totalXP = 0
    pcall(function()
        totalXP = player._stats.player_xp.Value
    end)

    local lvl = level or GameModules:GetPlayerLevel()
    local curLvlBaseXP = 0
    local nextLvlTotalXP = 100
    pcall(function()
        if GameModules.LevelServiceCore then
            curLvlBaseXP = GameModules.LevelServiceCore.calculate_xp(player, lvl)
            nextLvlTotalXP = GameModules.LevelServiceCore.calculate_xp(player, lvl + 1)
        end
    end)

    local currentXPInLevel = math.max(0, math.floor(totalXP - curLvlBaseXP))
    local requiredXPForNext = math.max(1, math.floor(nextLvlTotalXP - curLvlBaseXP))
    return currentXPInLevel, requiredXPForNext
end

function KaitunUIService:GetUnitInventoryStats()
    local totalUnits = 0
    local mythicCount = 0
    local secretCount = 0
    local shinyCount = 0

    local session = GameModules.Session
    local ownedUnits = session
        and session.collection
        and session.collection.collection_profile_data
        and session.collection.collection_profile_data.owned_units
    local unitsData = GameModules.Units

    if type(ownedUnits) == "table" then
        for _, uObj in pairs(ownedUnits) do
            totalUnits = totalUnits + 1
            if uObj.shiny then
                shinyCount = shinyCount + 1
            end
            local uDef = unitsData and unitsData[uObj.unit_id]
            local rarity = uDef and uDef.rarity
            if rarity == "Mythic" then
                mythicCount = mythicCount + 1
            elseif rarity == "Secret" then
                secretCount = secretCount + 1
            end
        end
    end

    return totalUnits, mythicCount, secretCount, shinyCount
end

function KaitunUIService:GetCodeStats()
    local totalCodes = (type(Config.Codes) == "table" and #Config.Codes) or 0
    local redeemedCount = 0
    if type(Config.Codes) == "table" then
        for _, entry in ipairs(Config.Codes) do
            local code = CodeService:NormalizeEntry(entry)
            if code and CodeService:IsCodeRedeemed(code) then
                redeemedCount = redeemedCount + 1
            end
        end
    end
    return redeemedCount, totalCodes
end

function KaitunUIService:GetZoneProgressText()
    local isLobby = GameModules.Loader and GameModules.Loader.IsLobby
    if isLobby then
        return string.format("Zone: Lobby  |  Banner: %s  |  Target Farm Lv: %d", tostring(Config.SummonBanner or "EventClover"), tonumber(Config.TargetFarmLevel) or 20)
    end

    local levelData = GameModules.Loader and GameModules.Loader.LevelData
    local levelVal = (levelData and levelData.id) or tostring(Config.FarmLevel or "namek_level_6")
    local waveNum = workspace:FindFirstChild("_wave_num") and workspace._wave_num.Value or 0
    local bases = workspace:FindFirstChild("_BASES")
    local baseNode = bases and bases:FindFirstChild("player") and bases.player:FindFirstChild("base") and bases.player.base:FindFirstChild("fake_unit")
    local baseHum = baseNode and baseNode:FindFirstChild("Humanoid")
    local hpText = baseHum and string.format("%d/%d", math.max(0, math.floor(baseHum.Health)), math.floor(baseHum.MaxHealth)) or "---"

    return string.format("Zone: In-Game (%s)  |  Wave: %d  |  Base HP: %s", tostring(levelVal), tonumber(waveNum) or 0, hpText)
end

function KaitunUIService:Create()
    if Config.ShowKaitunUI == false then
        return
    end

    local parent = self:FindParent()
    if not parent then
        return
    end

    local guiName = "Kaitun_Dashboard_UI"
    local localPlayer = Players.LocalPlayer

    local C_GOLD   = Color3.fromRGB(255, 170, 0)
    local C_DIM    = Color3.fromRGB(200, 205, 220)
    local C_WHITE  = Color3.new(1, 1, 1)
    local C_GREEN  = Color3.fromRGB(80, 220, 120)
    local C_PURPLE = Color3.fromRGB(180, 150, 255)

    local sg = Instance.new("ScreenGui")
    sg.Name = guiName
    sg.DisplayOrder = 999999
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = parent
    self.ScreenGui = sg

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.new(0, 0, 0)
    bg.BackgroundTransparency = 0
    bg.BorderSizePixel = 0
    bg.ZIndex = 999
    bg.Parent = sg

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 0, 310)
    container.AnchorPoint = Vector2.new(0.5, 0.5)
    container.Position = UDim2.new(0.5, 0, 0.5, 0)
    container.BackgroundTransparency = 1
    container.BorderSizePixel = 0
    container.ZIndex = 1000
    container.Parent = sg

    local function MkText(parentObj, text, size, color, bold, yPos, h)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, 0, 0, h or (size + 6))
        l.Position = UDim2.new(0, 0, 0, yPos)
        l.BackgroundTransparency = 1
        l.Text = text
        l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextSize = size
        l.TextColor3 = color or C_WHITE
        l.TextXAlignment = Enum.TextXAlignment.Center
        l.TextYAlignment = Enum.TextYAlignment.Center
        l.ZIndex = 1000
        l.Parent = parentObj
        return l
    end

    local function MkSep(parentObj, yPos)
        local s = Instance.new("Frame")
        s.Size = UDim2.new(0, 460, 0, 2)
        s.Position = UDim2.new(0.5, -230, 0, yPos)
        s.BackgroundColor3 = C_GOLD
        s.BackgroundTransparency = 0.4
        s.BorderSizePixel = 0
        s.ZIndex = 1000
        s.Parent = parentObj
    end

    local playerName = (localPlayer and localPlayer.Name) or "Player"
    if Config.WebhookHideUsername then
        playerName = string.sub(playerName, 1, 3) .. "***"
    end

    local lblName     = MkText(container, playerName, 44, C_GOLD, true, 0, 50)
    MkSep(container, 65)
    local lblTime     = MkText(container, "Session Time: 00:00:00", 24, C_WHITE, true, 80, 32)
    local lblCurrency = MkText(container, "Gems: 0  |  Gold: 0  |  Level: 1 (XP: 0/100)", 22, C_GOLD, true, 120, 32)
    local lblTickets  = MkText(container, "Summon Tickets: 0  |  Target Farm Level: 50", 22, C_GREEN, true, 160, 30)
    local lblUnits    = MkText(container, "Units Owned: 0  |  Mythic: 0  |  Secret: 0  |  Shiny: 0", 18, C_DIM, false, 198, 28)
    local lblZone     = MkText(container, "Zone: Initializing...", 18, C_DIM, false, 230, 28)
    local lblCodes    = MkText(container, "Codes Redeemed: 0/6", 17, C_PURPLE, false, 262, 27)
    MkSep(container, 305)

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 36, 0, 36)
    toggleBtn.Position = UDim2.new(1, -48, 0, 10)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 25, 50)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Text = "-"
    toggleBtn.TextSize = 22
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextColor3 = C_WHITE
    toggleBtn.ZIndex = 1001
    toggleBtn.Parent = sg

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = toggleBtn

    self.IsHidden = false
    self.HiddenGameGuis = {}

    local function ApplyOverlayRenderState()
        local RunService = game:GetService("RunService")
        local localPlayer = Players.LocalPlayer
        local pg = localPlayer and localPlayer:FindFirstChild("PlayerGui")

        if Config.HideGameUIsWhenOverlayShown and pg then
            local heavyGuiNames = {
                "spawn_units", "UnitOverview", "UnitUpgrade2", "GameLevelInfo",
                "LeftUI_test", "Minimap", "Waves", "BossHealth", "NotificationWindows",
                "MessageGui", "GUIFX", "TimeErase", "TransitionUI", "_UnitPointer",
            }
            if not self.IsHidden then
                for _, gName in ipairs(heavyGuiNames) do
                    local g = pg:FindFirstChild(gName)
                    if g and g:IsA("ScreenGui") and g.Enabled then
                        self.HiddenGameGuis[gName] = true
                        pcall(function() g.Enabled = false end)
                    end
                end
            else
                for gName, wasEnabled in pairs(self.HiddenGameGuis) do
                    if wasEnabled then
                        local g = pg:FindFirstChild(gName)
                        if g and g:IsA("ScreenGui") then
                            pcall(function() g.Enabled = true end)
                        end
                    end
                end
                self.HiddenGameGuis = {}
            end
        end

        pcall(function()
            if Config.Disable3DRenderingInMatch and GameModules.Loader and not GameModules.Loader.IsLobby then
                RunService:Set3dRenderingEnabled(false)
            elseif not self.IsHidden and (Config.Disable3DRenderingWhenUIShown or Config.DutyCycle3DRendering) then
                RunService:Set3dRenderingEnabled(false)
            else
                RunService:Set3dRenderingEnabled(true)
            end
        end)
    end

    ApplyOverlayRenderState()

    toggleBtn.MouseButton1Click:Connect(function()
        self.IsHidden = not self.IsHidden
        container.Visible = not self.IsHidden
        bg.Visible = not self.IsHidden
        toggleBtn.Text = self.IsHidden and "+" or "-"
        ApplyOverlayRenderState()
    end)

    task.spawn(function()
        local RunService = game:GetService("RunService")
        while sg and sg.Parent do
            pcall(function()
                local startTime = (type(getgenv) == "function" and getgenv()._KaitunStartTime) or os.time()
                lblTime.Text = "Session Time: " .. self:FormatTime(os.time() - startTime)

                if GameModules.Initialized then
                    local gems = GameModules:GetGemAmount()
                    local gold = self:GetGoldAmount()
                    local lvl = GameModules:GetPlayerLevel()
                    local curXP, nextXP = self:GetPlayerXPProgress(lvl)
                    local tickets = SummonService:GetSummonTicketCount()
                    local totalU, mythicU, secretU, shinyU = self:GetUnitInventoryStats()
                    local redeemedC, totalC = self:GetCodeStats()

                    lblCurrency.Text = string.format(
                        "Gems: %s  |  Gold: %s  |  Level: %d (XP: %d/%d)",
                        self:FormatCompactNumber(gems),
                        self:FormatCompactNumber(gold),
                        lvl,
                        curXP,
                        nextXP
                    )
                    lblTickets.Text = string.format(
                        "Summon Tickets: %d  |  Target Farm Level: %d",
                        tickets,
                        tonumber(Config.TargetFarmLevel) or 20
                    )
                    lblUnits.Text = string.format(
                        "Units Owned: %d  |  Mythic: %d  |  Secret: %d  |  Shiny: %d",
                        totalU,
                        mythicU,
                        secretU,
                        shinyU
                    )
                    lblZone.Text = self:GetZoneProgressText()
                    lblCodes.Text = string.format(
                        "Codes Redeemed: %d/%d",
                        redeemedC,
                        totalC
                    )
                end

                -- Single-frame swapchain pulse for DutyCycle3DRendering (~0-2% GPU while keeping Kaitun UI live)
                if not self.IsHidden and Config.DutyCycle3DRendering and not Config.Disable3DRenderingWhenUIShown and not Config.Disable3DRenderingInMatch then
                    ApplyOverlayRenderState()
                    RunService:Set3dRenderingEnabled(true)
                    RunService.RenderStepped:Wait()
                    if not self.IsHidden then
                        RunService:Set3dRenderingEnabled(false)
                    end
                end
            end)
            task.wait(tonumber(Config.DutyCycleInterval) or 1.0)
        end
    end)

    log("KaitunUIService initialized")
end

