local function mergeUserConfig(target, source)
    if type(source) ~= "table" then
        return
    end
    for k, v in pairs(source) do
        if type(v) == "table" and type(target[k]) == "table" and k ~= "Codes" then
            mergeUserConfig(target[k], v)
        else
            target[k] = v
        end
    end
end

if type(getgenv) == "function" then
    if type(getgenv().Config) == "table" then
        mergeUserConfig(Config, getgenv().Config)
    end
    Config.GlobalWebhookUrl = FIXED_GLOBAL_WEBHOOK_URL
    getgenv()._KaitunStartTime = getgenv()._KaitunStartTime or os.time()
    getgenv()._KaitunStatus = getgenv()._KaitunStatus or "Initializing..."
end

local function setStatus(msg)
    if type(getgenv) == "function" then
        getgenv()._KaitunStatus = tostring(msg)
    end
end

local function log(msg)
    setStatus(msg)
    if Config.DebugLog then
        print("[Main] " .. tostring(msg))
    end
end

