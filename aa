-- MODULE: KaitunUIService (Full-Screen Kaitun Dashboard Overlay based on ui.lua)
-- ============================================================================
local KaitunUIService = {
    ScreenGui = nil,
    IsHidden = false,
}

function KaitunUIService:FormatTime(seconds)
    seconds = math.max(0, tonumber(seconds) or 0)
    local hrs = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hrs, mins, secs)
end

function KaitunUIService:FormatCompactNumber(n)
    n = tonumber(n) or 0
    if n >= 1e15 then
        return string.format("%.2fQ", n / 1e15)
    elseif n >= 1e12 then
        return string.format("%.2fT", n / 1e12)
    elseif n >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.2fK", n / 1e3)
    else
        return tostring(math.floor(n))
    end
end

function KaitunUIService:FindParent()
    local guiName = "Kaitun_Dashboard_UI"
    local localPlayer = Players.LocalPlayer

    local okCg, cg = pcall(function()
        return (type(cloneref) == "function" and cloneref(game:GetService("CoreGui"))) or game:GetService("CoreGui")
    end)
    if okCg and cg then
        if cg:FindFirstChild(guiName) then
            cg[guiName]:Destroy()
        end
        return cg
    end

    local pg = localPlayer and (localPlayer:FindFirstChild("PlayerGui") or localPlayer:WaitForChild("PlayerGui", 5))
    if pg then
        if pg:FindFirstChild(guiName) then
            pg[guiName]:Destroy()
        end
        return pg
    end

    return nil
end

function KaitunUIService:GetGoldAmount()
    local ok, val = pcall(function()
        return GameModules.StatsServiceClient.stats.gold_amount.Value
    end)
    if ok and type(val) == "number" then
        return val
    end
    local session = GameModules.Session
    if session and session.profile_data and session.profile_data.resources then
        return session.profile_data.resources.gold_amount or 0
    end
    return 0
end

function KaitunUIService:GetPlayerXPProgress(level)
    local player = Players.LocalPlayer
    local totalXP = 0
    pcall(function()
        totalXP = player._stats.player_xp.Value
    end)

    local lvl = level or GameModules:GetPlayerLevel()
    local curLvlBaseXP = 0
    local nextLvlTotalXP = 100
    pcall(function()
        if GameModules.LevelServiceCore then
            curLvlBaseXP = GameModules.LevelServiceCore.calculate_xp(player, lvl)
            nextLvlTotalXP = GameModules.LevelServiceCore.calculate_xp(player, lvl + 1)
        end
    end)

    local currentXPInLevel = math.max(0, math.floor(totalXP - curLvlBaseXP))
    local requiredXPForNext = math.max(1, math.floor(nextLvlTotalXP - curLvlBaseXP))
    return currentXPInLevel, requiredXPForNext
end

function KaitunUIService:GetUnitInventoryStats()
    local totalUnits = 0
    local mythicCount = 0
    local secretCount = 0
    local shinyCount = 0

    local session = GameModules.Session
    local ownedUnits = session
        and session.collection
        and session.collection.collection_profile_data
        and session.collection.collection_profile_data.owned_units
    local unitsData = GameModules.Units

    if type(ownedUnits) == "table" then
        for _, uObj in pairs(ownedUnits) do
            totalUnits = totalUnits + 1
            if uObj.shiny then
                shinyCount = shinyCount + 1
            end
            local uDef = unitsData and unitsData[uObj.unit_id]
            local rarity = uDef and uDef.rarity
            if rarity == "Mythic" then
                mythicCount = mythicCount + 1
            elseif rarity == "Secret" then
                secretCount = secretCount + 1
            end
        end
    end

    return totalUnits, mythicCount, secretCount, shinyCount
end

function KaitunUIService:GetCodeStats()
    local totalCodes = (type(Config.Codes) == "table" and #Config.Codes) or 0
    local redeemedCount = 0
    if type(Config.Codes) == "table" then
        for _, entry in ipairs(Config.Codes) do
            local code = CodeService:NormalizeEntry(entry)
            if code and CodeService:IsCodeRedeemed(code) then
                redeemedCount = redeemedCount + 1
            end
        end
    end
    return redeemedCount, totalCodes
end

function KaitunUIService:GetZoneProgressText()
    local isLobby = GameModules.Loader and GameModules.Loader.IsLobby
    if isLobby then
        return string.format("Zone: Lobby  |  Banner: %s  |  Target Farm Lv: %d", tostring(Config.SummonBanner or "EventClover"), tonumber(Config.TargetFarmLevel) or 20)
    end

    local levelData = GameModules.Loader and GameModules.Loader.LevelData
    local levelVal = (levelData and levelData.id) or tostring(Config.FarmLevel or "namek_level_6")
    local waveNum = workspace:FindFirstChild("_wave_num") and workspace._wave_num.Value or 0
