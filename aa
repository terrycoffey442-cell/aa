-- MODULE: TrackerService (Local Web Tracker at http://localhost:8787)
-- ============================================================================
local TrackerService = {
    Url = "http://localhost:8787/api/push",
    Enabled = true,
    _running = false,
}

function TrackerService:GetRequestFunction()
    if type(request) == "function" then
        return request
    elseif type(http_request) == "function" then
        return http_request
    elseif type(syn) == "table" and type(syn.request) == "function" then
        return syn.request
    elseif type(http) == "table" and type(http.request) == "function" then
        return http.request
    elseif type(fluxus) == "table" and type(fluxus.request) == "function" then
        return fluxus.request
    end
    return nil
end

function TrackerService:Push(eventType, data)
    if not Config.TrackerEnabled and not self.Enabled then return end
    local reqFn = self:GetRequestFunction()
    if not reqFn then return end

    task.spawn(function()
        pcall(function()
            local accountName = "Player"
            if Players and Players.LocalPlayer and Players.LocalPlayer.Name then
                accountName = Players.LocalPlayer.Name
            end
            local payload = {
                type = eventType,
                account = accountName,
                timestamp = os.time(),
                data = data or {}
            }
            local body = HttpService:JSONEncode(payload)
            reqFn({
                Url = Config.TrackerUrl or self.Url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body
            })
        end)
    end)
end

function TrackerService:PushSnapshot()
    local gems = 0
    pcall(function() gems = GameModules:GetGemAmount() end)

    local gold = 0
    pcall(function()
        if KaitunUIService and KaitunUIService.GetGoldAmount then
            gold = KaitunUIService:GetGoldAmount()
        end
    end)

    local level = 1
    pcall(function() level = GameModules:GetPlayerLevel() end)

    local count, capacity = 0, 250
    pcall(function()
        if type(SellService) == "table" and SellService.GetCollectionSize then
            count, capacity = SellService:GetCollectionSize()
        end
    end)

    local traitTokens = 0
    pcall(function()
        local session = GameModules.Session
        if session and session.profile_data then
            traitTokens = session.profile_data.trait_reroll_tokens or 0
        end
    end)

    local tickets = 0
    local candy = 0
    pcall(function()
        local session = GameModules.Session
        if session and session.inventory and session.inventory.get_number_of_owned_item then
            tickets = session.inventory:get_number_of_owned_item("summon_ticket") or 0
            candy = session.inventory:get_number_of_owned_item("candy") or 0
        end
    end)

    local mythicCount, secretCount, uniqueCount, shinyCount = 0, 0, 0, 0
    local equippedList = {}
    local topUnitsList = {}
    local placeType = (GameModules.Loader and GameModules.Loader.IsLobby) and "Lobby" or "Match"

    pcall(function()
        local session = GameModules.Session
        local cpd = session and session.collection and session.collection.collection_profile_data
        local owned = (cpd and cpd.owned_units)
            or (session and session.profile_data and session.profile_data.collection and session.profile_data.collection.owned_units)
        local equippedMap = (cpd and cpd.equipped_units)
            or (session and session.profile_data and session.profile_data.collection and session.profile_data.collection.equipped_units)
            or {}
        local maxCap = (cpd and cpd.max_owned_units)
            or (session and session.profile_data and session.profile_data.collection and session.profile_data.collection.max_owned_units)
        if type(maxCap) == "number" and maxCap > 0 then
            capacity = maxCap
        end

        local unitsData = GameModules.Units or {}
        local rarityScore = { Secret = 6, Mythic = 5, Exclusive = 4, Legendary = 3, Epic = 2, Rare = 1, Common = 0 }

        local equippedSet = {}
        for _, eqUuid in pairs(equippedMap) do
            equippedSet[tostring(eqUuid)] = true
        end

        local ownedCount = 0
        local allCandidateUnits = {}
        if type(owned) == "table" then
            for uuid, uObj in pairs(owned) do
                if type(uObj) == "table" and uObj.unit_id then
                    ownedCount = ownedCount + 1
                    local uid = uObj.unit_id
                    local uDef = unitsData[uid] or {}
                    local rar = uDef.rarity or "Common"
                    local uName = uDef.name or uid
                    local isShiny = uObj.shiny == true
                    if isShiny then shinyCount = shinyCount + 1 end
                    if rar == "Mythic" then
                        mythicCount = mythicCount + 1
                    elseif rar == "Secret" then
                        secretCount = secretCount + 1
                    end

                    local traitNames = {}
                    local hasUnique = false
                    if type(uObj.traits) == "table" then
                        for _, t in ipairs(uObj.traits) do
                            local tid = t.trait or tostring(t)
                            table.insert(traitNames, tid)
                            if tid == "unique" then
                                hasUnique = true
                            end
                        end
                    elseif type(uObj.primary_trait) == "string" and uObj.primary_trait ~= "" then
                        table.insert(traitNames, uObj.primary_trait)
                        if uObj.primary_trait == "unique" then
                            hasUnique = true
                        end
                    end
                    if hasUnique then
                        uniqueCount = uniqueCount + 1
                    end

                    local isEq = equippedSet[tostring(uuid)] == true
                    local itemSummary = {
                        uuid = tostring(uuid),
                        unit_id = uid,
                        name = uName,
                        rarity = rar,
                        level = tonumber(uObj.level) or 1,
                        shiny = isShiny,
                        traits = traitNames,
                        image_url = UnitImages:GetUrl(uid),
                        equipped = isEq,
                        _score = (isEq and 10000 or 0) + (hasUnique and 5000 or 0) + ((rarityScore[rar] or 0) * 100) + (isShiny and 50 or 0) + (tonumber(uObj.level) or 1),
                    }

                    if isEq then
                        table.insert(equippedList, itemSummary)
                    end
                    table.insert(allCandidateUnits, itemSummary)
                end
            end
        end

        if ownedCount > 0 then
            count = ownedCount
        end

        table.sort(allCandidateUnits, function(a, b)
            return (a._score or 0) > (b._score or 0)
        end)
        for i = 1, math.min(24, #allCandidateUnits) do
            allCandidateUnits[i]._score = nil
            table.insert(topUnitsList, allCandidateUnits[i])
        end
    end)

    local userId = 0
    local displayName = ""
    pcall(function()
        local lp = Players.LocalPlayer
        if lp then
            userId = tonumber(lp.UserId) or 0
            displayName = tostring(lp.DisplayName or lp.Name or "")
        end
    end)

    self:Push("snapshot", {
        user_id = userId,
        display_name = displayName,
        gems = gems,
        gold = gold,
        units_count = count,
        capacity = capacity,
        level = level,
        trait_tokens = traitTokens,
        tickets = tickets,
        candy = candy,
        mythic_count = mythicCount,
        secret_count = secretCount,
        unique_count = uniqueCount,
        shiny_count = shinyCount,
        equipped_units = equippedList,
        top_units = topUnitsList,
        place_type = placeType,
    })
end

function TrackerService:PushSummon(unitData, banner, currency)
    if not unitData or not unitData.unit_id then return end
    local unitId = unitData.unit_id
    local unitDef = (GameModules.Units and GameModules.Units[unitId]) or {}
    local rarity = unitDef.rarity or "Common"
    local isShiny = unitData.shiny == true
    local traits = {}
    if type(unitData.traits) == "table" then
        for _, t in ipairs(unitData.traits) do
            table.insert(traits, t.trait or tostring(t))
        end
    end

    self:Push("summon", {
        unit_id = unitId,
        rarity = rarity,
        banner = banner or "Banner",
        currency = currency or "gems",
        is_shiny = isShiny,
        traits = traits,
    })

    task.spawn(function()
        task.wait(0.5)
        self:PushSnapshot()
    end)
end

function TrackerService:PushSell(count, uuids)
    if not count or count <= 0 then return end
    self:Push("sell", {
        count = count,
        uuids = uuids or {}
    })
    task.spawn(function()
        task.wait(0.5)
        self:PushSnapshot()
    end)
end

function TrackerService:PushTrait(data)
    self:Push("trait", data)
    task.spawn(function()
        task.wait(0.5)
        self:PushSnapshot()
    end)
end

function TrackerService:PushFarm(data)
    self:Push("farm", data)
    task.spawn(function()
        task.wait(0.5)
        self:PushSnapshot()
    end)
end

function TrackerService:PushQuest(questId, reward)
    self:Push("quest", {
        quest_id = questId,
        reward = reward or ""
    })
    task.spawn(function()
        task.wait(0.5)
        self:PushSnapshot()
    end)
end

function TrackerService:Start()
    if self._running then return end
    self._running = true

    task.spawn(function()
        task.wait(2)
        self:PushSnapshot()
    end)

    task.spawn(function()
        while self._running do
            task.wait(Config.TrackerSnapshotInterval or 60)
            pcall(function()
                self:PushSnapshot()
            end)
        end
    end)
end

