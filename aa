    toggleBtn.Text = "-"
    toggleBtn.TextSize = 22
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextColor3 = C_WHITE
    toggleBtn.ZIndex = 1001
    toggleBtn.Parent = sg

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = toggleBtn

    self.IsHidden = false
    if Config.Disable3DRenderingWhenUIShown then
        pcall(function()
            game:GetService("RunService"):Set3dRenderingEnabled(false)
        end)
    end

    toggleBtn.MouseButton1Click:Connect(function()
        self.IsHidden = not self.IsHidden
        container.Visible = not self.IsHidden
        bg.Visible = not self.IsHidden
        toggleBtn.Text = self.IsHidden and "+" or "-"

        pcall(function()
            if Config.Disable3DRenderingInMatch and GameModules.Loader and not GameModules.Loader.IsLobby then
                game:GetService("RunService"):Set3dRenderingEnabled(false)
            elseif Config.Disable3DRenderingWhenUIShown then
                game:GetService("RunService"):Set3dRenderingEnabled(self.IsHidden)
            else
                game:GetService("RunService"):Set3dRenderingEnabled(true)
            end
        end)
    end)

    task.spawn(function()
        while sg and sg.Parent do
            pcall(function()
                local startTime = (type(getgenv) == "function" and getgenv()._KaitunStartTime) or os.time()
                lblTime.Text = "Session Time: " .. self:FormatTime(os.time() - startTime)

                if GameModules.Initialized then
                    local gems = GameModules:GetGemAmount()
                    local gold = self:GetGoldAmount()
                    local lvl = GameModules:GetPlayerLevel()
                    local curXP, nextXP = self:GetPlayerXPProgress(lvl)
                    local tickets = SummonService:GetSummonTicketCount()
                    local totalU, mythicU, secretU, shinyU = self:GetUnitInventoryStats()
                    local redeemedC, totalC = self:GetCodeStats()

                    lblCurrency.Text = string.format(
                        "Gems: %s  |  Gold: %s  |  Level: %d (XP: %d/%d)",
                        self:FormatCompactNumber(gems),
                        self:FormatCompactNumber(gold),
                        lvl,
                        curXP,
                        nextXP
                    )
                    lblTickets.Text = string.format(
                        "Summon Tickets: %d  |  Target Farm Level: %d",
                        tickets,
                        tonumber(Config.TargetFarmLevel) or 20
                    )
                    lblUnits.Text = string.format(
                        "Units Owned: %d  |  Mythic: %d  |  Secret: %d  |  Shiny: %d",
                        totalU,
                        mythicU,
                        secretU,
                        shinyU
                    )
                    lblZone.Text = self:GetZoneProgressText()
                    lblCodes.Text = string.format(
                        "Codes Redeemed: %d/%d",
                        redeemedC,
                        totalC
                    )
                end
            end)
            task.wait(0.5)
        end
    end)

    log("KaitunUIService initialized")
end

