local JoinStart = {
    Hooked = false,
}

function JoinStart:HookStarterAndSummonReveal()
    if self.Hooked then
        return
    end

    local summonService = GameModules.SummonServiceClient
    if not summonService then
        return
    end

    if not summonService._orig_show_unit_and_item_rewards then
        summonService._orig_show_unit_and_item_rewards = summonService.show_unit_and_item_rewards
    end

    summonService.show_unit_and_item_rewards = function(items, units, isFirstUnits, a4, a5, a6)
        if isFirstUnits and Config.SkipStarterAnimation then
            log("Skipped starter unit star animation via hook")
            return
        end

        if Config.SkipSummonAnimation and type(a6) == "table" and a6._hatched_through_banner then
            log("Skipped banner summon star animation via hook")
            if type(units) == "table" and #units > 0 and summonService.on_units_hatched_through_banner then
                pcall(function()
                    summonService.on_units_hatched_through_banner(units)
                end)
            end
            return
        end

        return summonService._orig_show_unit_and_item_rewards(items, units, isFirstUnits, a4, a5, a6)
    end

    self.Hooked = true
end

function JoinStart:TriggerMouseClick()
    local camera = workspace.CurrentCamera
    local vp = camera and camera.ViewportSize or Vector2.new(800, 600)
    local cx, cy = math.floor(vp.X * 0.5), math.floor(vp.Y * 0.5)

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
    end)

    if type(getconnections) == "function" then
        pcall(function()
            local fakeInput = {
                UserInputType = Enum.UserInputType.MouseButton1,
                UserInputState = Enum.UserInputState.Begin,
                KeyCode = Enum.KeyCode.Unknown,
            }
            for _, conn in ipairs(getconnections(UserInputService.InputBegan)) do
                if conn.Function then
                    task.spawn(conn.Function, fakeInput, false)
                end
            end
        end)
    end
end

function JoinStart:DismissActiveSummonReveal(timeout)
    timeout = timeout or 15
    local guiService = GameModules.GUIService
    local summonUI = guiService and guiService.summon_ui
    if not summonUI or not summonUI.hatching then
        return
    end

    log("Starter star reveal is active, waiting for UnitInfoGUI to dismiss")
    local startClock = os.clock()
    while summonUI.hatching and (os.clock() - startClock < timeout) do
        if summonUI.unitInfoGUI and summonUI.unitInfoGUI.Enabled then
            self:TriggerMouseClick()
            task.wait(0.25)
        else
            task.wait(0.1)
        end
    end

    log("Starter star reveal dismissed")
end

function JoinStart:WaitForLoadingScreenFade(timeout)
    timeout = timeout or 15
    local localPlayer = Players.LocalPlayer
    local playerGui = localPlayer and localPlayer:FindFirstChild("PlayerGui")
    if not playerGui then
        return
    end

    local startClock = os.clock()
    while os.clock() - startClock < timeout do
        local loadingGui = playerGui:FindFirstChild("Loading")
        if not loadingGui or not loadingGui.Enabled then
            break
        end
        local bg = loadingGui:FindFirstChild("bg")
        if bg and bg.BackgroundTransparency >= 0.95 then
            break
        end
        task.wait(0.1)
    end
end

function JoinStart:DismissLobbyPopups(timeout)
    timeout = timeout or 15
    local guiService = GameModules.GUIService
    local loginService = GameModules.LoginServiceClient
    if not guiService or not loginService then
        return
    end

    local startClock = os.clock()
    while os.clock() - startClock < timeout do
        if guiService.summon_ui and guiService.summon_ui.hatching then
            self:DismissActiveSummonReveal(10)
        end

        if Config.AutoCloseUpdateUI and guiService.update_ui and guiService.update_ui.IsOpen then
            log("Closing UpdateUI window")
            pcall(function()
                guiService.update_ui:toggle()
            end)
            task.wait(0.2)
        end

        if loginService._ready then
            break
        end

        local isFirstLoad = loginService.session
            and loginService.session.profile_data
            and loginService.session.profile_data._FIRST_LOAD
        local isFirstUpdate = loginService.session and loginService.session.first_join_on_update
        if not isFirstLoad and not isFirstUpdate then
            pcall(function()
                loginService.on_ready()
            end)
            break
        end

        task.wait(0.15)
    end

    if not loginService._ready then
        pcall(function()
            loginService.on_ready()
        end)
    end

    if Config.AutoCloseCalendarUI and guiService.christmas_calendar_ui and guiService.christmas_calendar_ui.IsOpen then
        log("Closing HolidayRewards calendar window")
        pcall(function()
            guiService.christmas_calendar_ui:hide(true)
        end)
    end

    pcall(function()
        guiService.blur_off(true)
        guiService.open_all_dockables()
    end)
end

function JoinStart:GetStarterUnitUUID()
    local loginService = GameModules.LoginServiceClient
    local session = GameModules.Session
    if not session then
        return nil
    end

    if loginService and type(loginService.first_units) == "table" and loginService.first_units[1] then
        return loginService.first_units[1]
    end

    local ownedUnits = session.profile_data
        and session.profile_data.collection
        and session.profile_data.collection.owned_units
    if type(ownedUnits) == "table" then
        local firstUuid = next(ownedUnits)
        return firstUuid
    end

    return nil
end

function JoinStart:EnsureStarterUnitEquipped()
    if not Config.AutoEquipStarterUnit then
        return true
    end

    local session = GameModules.Session
    if not session or not session.collection then
        return false
    end

    if session.collection:get_used_equipped_slots() > 0 then
        log("Equipped unit slot already populated")
        return true
    end

    if session.profile_data and session.profile_data._FIRST_LOAD then
        pcall(function()
            GameModules:InvokeServer("equip_first_units")
        end)
        task.wait(0.25)
    end

    if session.collection:get_used_equipped_slots() > 0 then
        log("Equipped starter unit via equip_first_units")
        return true
    end

    local targetUuid = self:GetStarterUnitUUID()
    if not targetUuid then
        warn("[Main] No owned unit found to equip")
        return false
    end

    log("Equipping unit UUID: " .. tostring(targetUuid))
    pcall(function()
        GameModules:InvokeServer("equip_unit", targetUuid)
    end)

    local startClock = os.clock()
    while os.clock() - startClock < 3 do
        if session.collection:get_used_equipped_slots() > 0 then
            log("Unit equipped successfully")
            return true
        end
        task.wait(0.1)
    end

    return session.collection:get_used_equipped_slots() > 0
end

function JoinStart:Run()
    if not GameModules:Init(Config.JoinTimeout) then
        return false
    end

    WebhookService:HookUnitAdded()
    self:HookStarterAndSummonReveal()

    if not GameModules.Loader.IsLobby then
        log("Current place is not Lobby, skipping lobby JoinStart flow")
        return true
    end

    log("Starting JoinStart handler")
    self:WaitForLoadingScreenFade(15)
    self:DismissActiveSummonReveal(15)
    self:DismissLobbyPopups(15)
    self:EnsureStarterUnitEquipped()
    log("JoinStart complete, client ready")

    return true
end

-- ============================================================================
-- MODULE: CodeService (Auto Redeem Codes with minLevel & Redeemed Filter)
-- ============================================================================
local CodeService = {}

function CodeService:NormalizeEntry(entry)
    if type(entry) == "string" then
        return entry, 1
    elseif type(entry) == "table" and type(entry.code) == "string" then
        return entry.code, tonumber(entry.minLevel) or 1
    end
    return nil, 1
end

function CodeService:IsCodeRedeemed(code)
    local session = GameModules.Session
    local redeemed = session and session.profile_data and session.profile_data.redeemed_codes
    if type(redeemed) ~= "table" then
        return false
    end

    local upper = string.upper(code)
    local lower = string.lower(code)
    if redeemed[code] or redeemed[upper] or redeemed[lower] then
        return true
    end

    for _, val in pairs(redeemed) do
        if type(val) == "string" and string.upper(val) == upper then
            return true
        end
    end

    return false
end

function CodeService:MarkCodeRedeemedLocal(code)
    local session = GameModules.Session
    if not session or not session.profile_data then
        return
    end
    if type(session.profile_data.redeemed_codes) ~= "table" then
        session.profile_data.redeemed_codes = {}
    end
    session.profile_data.redeemed_codes[code] = true
end

function CodeService:RedeemSingle(entry, playerLevel)
    local code, minLevel = self:NormalizeEntry(entry)
    if not code or code == "" then
        return false, "invalid_entry"
    end

    playerLevel = playerLevel or GameModules:GetPlayerLevel()
    if playerLevel < minLevel then
        log(string.format("Skipped code %s (requires Lv. %d+, current Lv. %d)", code, minLevel, playerLevel))
        return false, "skipped_level"
    end

    if self:IsCodeRedeemed(code) then
        log(string.format("Skipped code %s (already redeemed)", code))
        return false, "already_redeemed"
    end

    local guiService = GameModules.GUIService
    local msgUI = guiService and guiService.message_ui
    local lastServerMsg = nil
    local lastServerColor = nil

    if msgUI and not msgUI._orig_show_message then
        msgUI._orig_show_message = msgUI.show_message
    end
    local origShow = msgUI and msgUI._orig_show_message

    if msgUI and origShow then
        msgUI.show_message = function(uiSelf, text, color, a3, a4, a5)
            lastServerMsg = tostring(text or "")
            lastServerColor = tostring(color or "")
            return origShow(uiSelf, text, color, a3, a4, a5)
        end
    end

    local ok, err = pcall(function()
        GameModules:InvokeServer("redeem_code", code)
    end)

    if ok and msgUI and origShow then
        local t0 = os.clock()
        while not lastServerMsg and (os.clock() - t0 < 0.5) do
            task.wait(0.05)
        end
    end

    if msgUI and origShow then
        msgUI.show_message = origShow
    end

    if not ok then
        warn("[Main] Error redeeming code " .. code .. ": " .. tostring(err))
        return false, "invoke_error"
    end

    local msgLower = string.lower(lastServerMsg or "")
    if lastServerColor == "Success" or string.find(msgLower, "code redeemed") then
        self:MarkCodeRedeemedLocal(code)
        log(string.format("Code %s: Redeemed (%s)", code, lastServerMsg or "Success"))
        return true, "redeemed"
    elseif string.find(msgLower, "already redeemed") then
        self:MarkCodeRedeemedLocal(code)
        log(string.format("Code %s: Already redeemed", code))
        return false, "already_redeemed"
    elseif string.find(msgLower, "must be level") then
        log(string.format("Code %s: %s", code, lastServerMsg))
        return false, "skipped_level"
    elseif lastServerColor == "Error" or string.find(msgLower, "unknown") or string.find(msgLower, "expired") or string.find(msgLower, "invalid") then
        log(string.format("Code %s: %s", code, lastServerMsg or "Invalid/Expired"))
        return false, "invalid_or_expired"
    else
        log(string.format("Code %s: Sent (%s)", code, lastServerMsg or "No message"))
        return true, "redeemed"
    end
end

function CodeService:RedeemAll()
    if not Config.AutoRedeemCodes then
        return
    end

    if not GameModules.Loader or not GameModules.Loader.IsLobby then
        log("Current place is not Lobby, skipping CodeService")
        return
    end

    local codes = Config.Codes
    if type(codes) ~= "table" or #codes == 0 then
        return
    end

    local playerLevel = GameModules:GetPlayerLevel()
    log(string.format("Starting CodeService (Player Level: %d, Total Codes: %d)", playerLevel, #codes))

    for _, entry in ipairs(codes) do
        local redeemed, status = self:RedeemSingle(entry, playerLevel)
        if status ~= "skipped_level" and status ~= "already_redeemed" and status ~= "invalid_entry" then
            task.wait(Config.RedeemCodeDelay or 0.35)
        end
    end

    log("CodeService finished")
end

