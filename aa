end

function SummonService:GetGemCosts(bannerName)
    local banners = GameModules.Banners
    local bannerDef = banners and banners[bannerName]
    local baseGemCost = (bannerDef and bannerDef.gem_cost) or 50
    local summonCore = GameModules.SummonServiceCore
    local session = GameModules.Session

    local singleCost = baseGemCost
    if summonCore and session then
        local ok, calc = pcall(function()
            return summonCore.calculate_hatch_price(session, baseGemCost, "gems")
        end)
        if ok and type(calc) == "number" and calc > 0 then
            singleCost = calc
        end
    end

    return singleCost, singleCost * 10
end

function SummonService:WaitUntilHatchComplete(timeout)
    timeout = timeout or 12
    local guiService = GameModules.GUIService
    local summonUI = guiService and guiService.summon_ui
    if not summonUI then
        return
    end

    local t0 = os.clock()
    while summonUI.hatching and (os.clock() - t0 < timeout) do
        if summonUI.unitInfoGUI and summonUI.unitInfoGUI.Enabled then
            JoinStart:TriggerMouseClick()
            task.wait(0.2)
        else
            task.wait(0.1)
        end
    end
end

function SummonService:ShouldStopByTargetRarity()
    if Config.StopSummonOnSecret and WebhookService.ObtainedSecretInSession then
        log("Stopping AutoSummon: Obtained Secret unit in session")
        return true
    end
    if Config.StopSummonOnMythic and WebhookService.ObtainedMythicInSession then
        log("Stopping AutoSummon: Obtained Mythic unit in session")
        return true
    end
    return false
end

function SummonService:Run()
    -- Global cross-instance lock (prevents race if script re-executed while still running)
    if type(getgenv) == "function" then
        if getgenv()._AA_SummonRunning then
            log("SummonService: another instance already running, skipping")
            return
        end
        getgenv()._AA_SummonRunning = true
    end

    if not Config.AutoSummonEnabled then
        if type(getgenv) == "function" then getgenv()._AA_SummonRunning = nil end
        return
    end

    if not GameModules.Loader or not GameModules.Loader.IsLobby then
        if type(getgenv) == "function" then getgenv()._AA_SummonRunning = nil end
        return
    end

    local playerLevel = GameModules:GetPlayerLevel()
    if Config.AutoFarmEnabled and playerLevel < (Config.TargetFarmLevel or 1) then
        log(string.format("Skipping SummonService: Player Level (%d) < TargetFarmLevel (%d)", playerLevel, Config.TargetFarmLevel))
        if type(getgenv) == "function" then getgenv()._AA_SummonRunning = nil end
        return
    end

    local bannerName = Config.SummonBanner or "EventClover"
    local banners = GameModules.Banners
    local bannerDef = banners and banners[bannerName]
    if not bannerDef then
        warn("[Main] Invalid SummonBanner in Config: " .. tostring(bannerName))
        if type(getgenv) == "function" then getgenv()._AA_SummonRunning = nil end
        return
    end

    self.Running = true
    local singleCost, tenCost = self:GetGemCosts(bannerName)
    local keepGems = Config.KeepGemAmount or 0
    log(string.format("Starting SummonService on banner '%s' (1x=%d Gems, 10x=%d Gems, Keep=%d)", bannerName, singleCost, tenCost, keepGems))

    -- 1. Use Summon Tickets first if enabled and allowed on banner
    if Config.UseSummonTickets and not bannerDef._no_summon_ticket then
        while self.Running and not self:ShouldStopByTargetRarity() do
            local tickets = self:GetSummonTicketCount()
            if tickets <= 0 then
                break
            end

            log(string.format("Summoning 1x with Summon Ticket on %s (Tickets left: %d)", bannerName, tickets))
            self.CurrentBanner = bannerName
            self.CurrentCurrency = "ticket"
            pcall(function()
                GameModules:InvokeServer("buy_from_banner", bannerName, "ticket")
            end)
            task.wait(Config.SummonDelay or 0.4)
            self:WaitUntilHatchComplete(10)
        end
    end

    -- 2. Use Gems
    -- Note: "gems10" is rejected by server for rateup banners (e.g. EventClover).
    -- Always use "gems" (single). PreferTenPull = do 10 singles in a row.
    while self.Running and not self:ShouldStopByTargetRarity() do
        -- auto-sell junk if collection near full before each pull batch
        if type(SellService) == "table" then
            if Config.AutoSellEnabled then
                pcall(function() SellService:SellJunk() end)
                task.wait(1)
            end
            local waitFull = 0
            while waitFull < 6 do
                local c2, cap2 = SellService:GetCollectionSize()
                if cap2 <= 0 or c2 < cap2 then break end
                log(string.format("SummonService: waiting for collection to clear (%d/%d)...", c2, cap2))
                task.wait(1.2)
                waitFull = waitFull + 1
            end
            local cFinal, capFinal = SellService:GetCollectionSize()
            if capFinal > 0 and cFinal >= capFinal then
                log(string.format("SummonService: collection full (%d/%d) and no sellable units left, stopping", cFinal, capFinal))
                break
            end
        end

        local currentGems = GameModules:GetGemAmount()
        local spendableGems = currentGems - keepGems

        if not Config.AllowSinglePull and spendableGems < singleCost then
            break
        end
        if spendableGems < singleCost then
            break
        end

        local pullCount = 1
        if Config.PreferTenPull and spendableGems >= tenCost then
            pullCount = 10
        end

        log(string.format("Summoning %dx on %s (Gems: %d)", pullCount, bannerName, currentGems))
        self.CurrentBanner = bannerName
        self.CurrentCurrency = "gems"
        for i = 1, pullCount do
            if self:ShouldStopByTargetRarity() then break end
            local gemsNow = GameModules:GetGemAmount()
            if (gemsNow - keepGems) < singleCost then break end
            pcall(function()
                GameModules:InvokeServer("buy_from_banner", bannerName, "gems")
            end)
            task.wait(Config.SummonDelay or 0.4)
            self:WaitUntilHatchComplete(10)
        end
    end

    self.Running = false
    if type(getgenv) == "function" then getgenv()._AA_SummonRunning = nil end
    log(string.format("SummonService finished (Remaining Gems: %d)", GameModules:GetGemAmount()))
end

