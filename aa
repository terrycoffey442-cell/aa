-- ============================================================================
-- MODULE: TraitService (Auto Use Trait Reroll Tokens)
-- Rules:
--   - Only reroll units with rarity >= Mythic (Exclusive < Mythic < Secret)
--   - Scan ALL owned units (not just equipped), pick Mythic+ sorted Secret > Mythic
--   - Stop rolling on a unit if it gets a Mythic-rarity trait (divine/reaper/golden/ethereal/unique)
--   - If unique trait detected: send webhook notification
-- Source: TraitRerollUI.lua L93 invoke_server("request_token_trait_reroll", uuid)
--         trait_reroll_tokens at session.profile_data.trait_reroll_tokens
--         traits at session.collection.collection_profile_data.owned_units[uuid].traits
--         Traits data: ReplicatedStorage.src.Data.Traits
-- ============================================================================
local TraitService = {}

-- Rarity rank: higher = better. Mirrors UNIT_RARITIES order from GameplaySettings.
local RARITY_RANK = {
    Common = 1, Rare = 2, Epic = 3, Legendary = 4,
    Exclusive = 5, Mythic = 6, Secret = 7,
}
local MIN_TRAIT_RARITY_RANK = RARITY_RANK["Mythic"] -- only Mythic and Secret units eligible

-- Trait data from ReplicatedStorage.src.Data.Traits
-- rarity: Rare < Legendary < Mythic. Stop rolling when unit has any Mythic-rarity trait.
local TRAIT_INFO = {
    superior      = { name = "Superior",  rarity = "Rare" },
    range         = { name = "Range",     rarity = "Rare" },
    nimble        = { name = "Nimble",    rarity = "Rare" },
    culling       = { name = "Culling",   rarity = "Legendary" },
    neuroplasticity = { name = "Adept",   rarity = "Legendary" },
    sniper        = { name = "Sniper",    rarity = "Legendary" },
    godspeed      = { name = "Godspeed",  rarity = "Legendary" },
    reaper        = { name = "Reaper",    rarity = "Mythic" },
    golden        = { name = "Golden",    rarity = "Mythic" },
    divine        = { name = "Divine",    rarity = "Mythic" },
    ethereal      = { name = "Celestial", rarity = "Mythic" },
    unique        = { name = "Unique",    rarity = "Mythic" },
}
local TRAIT_RARITY_RANK = { Rare = 1, Legendary = 2, Mythic = 3 }

-- Returns true if traits table contains any Mythic-rarity trait (stop condition)
local function HasMythicTrait(traits)
    if type(traits) ~= "table" then return false, nil end
    for _, t in ipairs(traits) do
        local info = TRAIT_INFO[t.trait]
        if info and (TRAIT_RARITY_RANK[info.rarity] or 0) >= TRAIT_RARITY_RANK["Mythic"] then
            return true, t.trait
        end
    end
    return false, nil
end

-- Returns true if traits table contains "unique" specifically
local function HasUniqueTrait(traits)
    if type(traits) ~= "table" then return false end
    for _, t in ipairs(traits) do
        if t.trait == "unique" then return true end
    end
    return false
end

-- Format traits for logging: "Unique(Mythic) + Sniper(Legendary)"
local function FormatTraits(traits)
    if type(traits) ~= "table" or #traits == 0 then return "none" end
    local parts = {}
    for _, t in ipairs(traits) do
        local info = TRAIT_INFO[t.trait]
        local name = info and info.name or t.trait
        local rar  = info and info.rarity or "?"
        table.insert(parts, string.format("%s(%s)", name, rar))
    end
    return table.concat(parts, " + ")
end

function TraitService:GetTokenCount()
    local session = GameModules.Session
    if not session or not session.profile_data then return 0 end
    local n = session.profile_data.trait_reroll_tokens
    return (type(n) == "number") and n or 0
end

-- Returns unit's current traits table (or nil)
function TraitService:GetUnitTraits(uuid)
    local session = GameModules.Session
    if not session or not session.collection then return nil end
    local unit = session.collection.collection_profile_data.owned_units[uuid]
    return unit and unit.traits
end

-- Check if traits list contains "unique"
function TraitService:HasUniqueTrait(traits)
    return HasUniqueTrait(traits)
end

-- Get unit rarity rank from Units data
function TraitService:GetUnitRarityRank(unit_id)
    local unitDef = GameModules.Units and GameModules.Units[unit_id]
    if not unitDef then return 0 end
    return RARITY_RANK[unitDef.rarity] or 0
end

-- Build list of eligible uuid from ALL owned units (Mythic+ rarity)
-- Sorted by rarity DESC (Secret first), then pick the best one to reroll
-- TraitRerollTargetUnits whitelist applies if set
function TraitService:GetEligibleUuids()
    local session = GameModules.Session
    if not session or not session.collection then return {} end
    local cpd = session.collection.collection_profile_data
    local owned = cpd and cpd.owned_units
    if type(owned) ~= "table" then return {} end

    local targets = Config.TraitRerollTargetUnits
    local hasTargetFilter = type(targets) == "table" and #targets > 0

    local targetSet = {}
    if hasTargetFilter then
        for _, tid in ipairs(targets) do targetSet[tid] = true end
    end

    local result = {}
    for uuid, unit in pairs(owned) do
        if type(unit) == "table" then
            local rank = self:GetUnitRarityRank(unit.unit_id)
            if rank >= MIN_TRAIT_RARITY_RANK then
                if not hasTargetFilter or targetSet[unit.unit_id] then
                    table.insert(result, {uuid = uuid, rank = rank, unit_id = unit.unit_id})
                end
            end
        end
    end

    -- sort: Secret > Mythic, same rarity = keep stable order
    table.sort(result, function(a, b) return a.rank > b.rank end)

    local uuids = {}
    for _, entry in ipairs(result) do
        table.insert(uuids, entry.uuid)
    end
    return uuids
end

-- Send webhook when unique trait rolled
function TraitService:NotifyUnique(uuid)
    local session = GameModules.Session
    local unit = session and session.collection
        and session.collection.collection_profile_data.owned_units[uuid]
    if not unit then return end

    local unitDef = GameModules.Units and GameModules.Units[unit.unit_id]
    local unitName = (unitDef and unitDef.name) or unit.unit_id
    local rarity = (unitDef and unitDef.rarity) or "?"

    WebhookService:SendUnitNotification(unit, string.format("[UNIQUE TRAIT 0.1%%] %s (%s)", unitName, rarity))
end

function TraitService:UseTokens()
    if not Config.AutoUseTrait then return end
    if not GameModules.Loader or not GameModules.Loader.IsLobby then return end

    local tokens = self:GetTokenCount()
    local keep = tonumber(Config.MaxTraitTokensToKeep) or 0
    local toUse = tokens - keep

    if toUse <= 0 then
        log("TraitService: tokens=" .. tokens .. " keep=" .. keep .. " skip")
        return
    end

    local uuids = self:GetEligibleUuids()
    if #uuids == 0 then
        log("TraitService: no Mythic+ units in collection eligible for reroll")
        return
    end

    log(string.format("TraitService: %d tokens to use, %d Mythic+ units eligible (Secret-first order)", toUse, #uuids))

    local used = 0
    local idx = 1
    while used < toUse do
        -- skip units that already have a Mythic-rarity trait (stop condition)
        local skipped = 0
        while skipped < #uuids do
            local currentTraits = self:GetUnitTraits(uuids[idx])
            local hasMythic, mythicId = HasMythicTrait(currentTraits)
            if hasMythic then
                local info = TRAIT_INFO[mythicId]
                log(string.format("TraitService: %s already has %s trait, skipping",
                    uuids[idx], info and info.name or mythicId))
                idx = idx + 1
                if idx > #uuids then idx = 1 end
                skipped = skipped + 1
            else
                break
            end
        end
        if skipped >= #uuids then
            log("TraitService: all eligible units already have Mythic-rarity trait, stopping")
            break
        end

        local uuid = uuids[idx]

        -- snapshot traits before reroll
        local traitsBefore = self:GetUnitTraits(uuid)

        local ok, err = pcall(function()
            GameModules:InvokeServer("request_token_trait_reroll", uuid)
        end)

        if not ok then
            log("TraitService: reroll error uuid=" .. uuid .. " err=" .. tostring(err))
            task.wait(1)
        else
            used = used + 1
            -- wait for server to update traits
            task.wait(0.8)

            local traitsAfter = self:GetUnitTraits(uuid)
            local traitStr = FormatTraits(traitsAfter)
            log(string.format("TraitService: rolled -> %s (token %d/%d)", traitStr, used, toUse))

            -- Push trait roll event to Tracker
            if TrackerService and TrackerService.PushTrait and type(traitsAfter) == "table" then
                local unitId = nil
                local session = GameModules.Session
                if session and session.collection and session.collection.collection_profile_data then
                    local unit = session.collection.collection_profile_data.owned_units[uuid]
                    if unit then unitId = unit.unit_id end
                end
                for _, t in ipairs(traitsAfter) do
                    local tid = t.trait
                    local info = TRAIT_INFO[tid] or {}
                    local tName = info.name or tid
                    local tRarity = info.rarity or "Rare"
                    local isUniq = (tid == "unique")
                    pcall(function()
                        TrackerService:PushTrait({
                            unit_id = unitId,
                            uuid = uuid,
                            trait_id = tid,
                            trait_name = tName,
                            trait_rarity = tRarity,
                            is_unique = isUniq,
                        })
                    end)
                end
            end

            -- check if unique specifically
            if HasUniqueTrait(traitsAfter) and not HasUniqueTrait(traitsBefore) then
                log("TraitService: *** UNIQUE TRAIT (0.1%) on " .. uuid .. " ***")
                pcall(function() self:NotifyUnique(uuid) end)
            end

            -- if Mythic-rarity trait landed, move to next unit
            local hasMythicNow = HasMythicTrait(traitsAfter)
            if hasMythicNow then
                log("TraitService: Mythic trait on this unit, moving to next")
                idx = idx + 1
                if idx > #uuids then idx = 1 end
            end
        end

        task.wait(0.4)
    end

    log("TraitService: done, used=" .. used .. " tokens")
end

-- ============================================================================
-- MODULE: SellService (Auto Sell Junk Units When Inventory Full)
-- Source ref: CollectionUI.lua L408: invoke_server("sell_units", u10) -- u10 = array of uuid strings
--             UnitCollection.lua L36: size() = table_size(owned_units)
--             UNIT_RARITIES in GameplaySettings = ['Common','Rare','Epic','Legendary','Exclusive','Mythic','Secret']
-- ============================================================================
local SellService = {}

function SellService:GetCollectionSize()
    local session = GameModules.Session
    if not session or not session.collection then return 0, 250 end
    local cpd = session.collection.collection_profile_data
    -- capacity is live-updated via on_capacity_changed (UnitCollectionServiceClient.lua L157)
    local capacity = cpd and cpd.capacity
    if not capacity or capacity <= 0 then
        capacity = tonumber(Config.AutoSellCapacity) or 250
    end
    local count = 0
    local owned = cpd and cpd.owned_units
    if type(owned) == "table" then
        for _ in pairs(owned) do count = count + 1 end
    end
    return count, capacity
end

function SellService:CollectSellableUuids()
    local session = GameModules.Session
    if not session or not session.collection then return {} end
    local owned = session.collection.collection_profile_data
        and session.collection.collection_profile_data.owned_units
    if type(owned) ~= "table" then return {} end

    local equipped = session.collection.collection_profile_data.equipped_units or {}
    -- build equipped uuid set for O(1) lookup
    local equippedSet = {}
    for _, uuid in pairs(equipped) do
        equippedSet[uuid] = true
    end

    local sellRarities = (type(Config.AutoSellRarities) == "table") and Config.AutoSellRarities or {}
    local sellList = {}

    for uuid, unit in pairs(owned) do
        if type(unit) ~= "table" then continue end

        -- skip locked units if configured
        if Config.AutoSellKeepLocked and unit._locked then continue end

        -- skip equipped units if configured
        if Config.AutoSellKeepEquipped and equippedSet[uuid] then continue end

        -- check rarity
        local unitDef = GameModules.Units and GameModules.Units[unit.unit_id]
        local rarity = unitDef and unitDef.rarity
        if rarity and sellRarities[rarity] then
            table.insert(sellList, uuid)
        end
    end

    return sellList
end

function SellService:SellJunk()
    if not Config.AutoSellEnabled then
        return
    end

    local count, capacity = self:GetCollectionSize()
    local threshold = tonumber(Config.AutoSellThreshold) or 0.85
    local ratio = (capacity > 0) and (count / capacity) or 0

    if ratio < threshold then
        log(string.format("SellService: inventory %d/%d (%.0f%%) below threshold %.0f%%, skipping",
            count, capacity, ratio * 100, threshold * 100))
        return
    end

    log(string.format("SellService: inventory %d/%d (%.0f%%) >= threshold, collecting sellable units",
        count, capacity, ratio * 100))

    local toSell = self:CollectSellableUuids()
    if #toSell == 0 then
        log("SellService: no sellable units found (check AutoSellRarities config)")
        return
    end

    log("SellService: selling " .. #toSell .. " units")

    -- sell in batches of 50 (safe limit)
    local BATCH = 50
    local sold = 0
    for i = 1, #toSell, BATCH do
        local batch = {}
        for j = i, math.min(i + BATCH - 1, #toSell) do
            table.insert(batch, toSell[j])
        end
        local ok, err = pcall(function()
            GameModules:InvokeServer("sell_units", batch)
        end)
        if ok then
            sold = sold + #batch
            log("SellService: sold batch " .. #batch .. " (total=" .. sold .. ")")
            if TrackerService and TrackerService.PushSell then
                pcall(function()
                    TrackerService:PushSell(#batch, batch)
                end)
            end
        else
            log("SellService: sell_units error: " .. tostring(err))
        end
        task.wait(0.5)
    end

    log("SellService: done, sold " .. sold .. " units")
end

-- ============================================================================
-- MAIN ENTRY POINT
-- ============================================================================
local Main = {
    Config = Config,
    GameModules = GameModules,
    UnitImages = UnitImages,
    WebhookService = WebhookService,
    TrackerService = TrackerService,
    JoinStart = JoinStart,
    DailyService = DailyService,
    CodeService = CodeService,
    SummonService = SummonService,
    FarmService = FarmService,
    AntiAfkService = AntiAfkService,
    PerformanceService = PerformanceService,
    KaitunUIService = KaitunUIService,
    TraitService = TraitService,
    SellService = SellService,
}

function Main:Start()
    self.KaitunUIService:Create()
    self.AntiAfkService:Start()
    if self.TrackerService and self.TrackerService.Start then
        self.TrackerService:Start()
    end

    local ok = self.JoinStart:Run()
    if not ok then
        warn("[Main] JoinStart failed")
        return false
    end

    self.PerformanceService:Start()
    self.FarmService:SetupTeleportAutoReload()

    if GameModules.Loader.IsLobby then
        self.DailyService:ClaimAll()   -- claim daily, calendar, milestones, completed quests
        self.CodeService:RedeemAll()
        self.SellService:SellJunk()    -- sell junk before summon to free space
        self.TraitService:UseTokens()  -- use trait tokens on equipped units

        if self.FarmService:ShouldFarm() then
            self.FarmService:EnterStoryMatch()
        else
            self.SummonService:Run()
        end
    else
        self.FarmService:RunInGame()
    end

    return true
end

Main:Start()
if type(getgenv) == "function" then
    getgenv().AA_Main = Main
end
return Main
