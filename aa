-- MODULE: DailyService (Auto Claim Daily Login, Holiday Calendar, Milestones, Quests)
-- ============================================================================
local DailyService = {}

function DailyService:ClaimDailyReward()
    if not Config.AutoClaimDaily then
        return false
    end

    local session = GameModules.Session
    local gs = GameModules.GameplaySettings
    local guiService = GameModules.GUIService
    if not session or not session.profile_data then
        return false
    end

    local lastClaimed = session.profile_data.last_daily_reward_claimed_time or 0
    local waitTime = (gs and gs.DAILY_REWARD_WAIT) or 82800
    local now = os.time()
    local dailyUI = guiService and guiService.daily_rewards_ui
    local canClaim = ((now - lastClaimed) >= waitTime) or (dailyUI and dailyUI.screenGUI and dailyUI.screenGUI.Enabled)

    if not canClaim then
        return false
    end

    log("Claiming Daily Login Reward")
    pcall(function()
        GameModules:InvokeServer("claim_daily_reward")
    end)

    if dailyUI and dailyUI.screenGUI then
        pcall(function()
            dailyUI.__clicked_once = true
            dailyUI.screenGUI.Enabled = false
        end)
    end

    return true
end

function DailyService:ClaimHolidayCalendar()
    if not Config.AutoClaimHolidayCalendar then
        return false
    end

    local session = GameModules.Session
    local specialService = GameModules.SpecialEventServiceClient
    local holidayRewards = GameModules.HolidayRewards
    local guiService = GameModules.GUIService
    if not session or not session.profile_data or not specialService or not holidayRewards then
        return false
    end

    local availDay = specialService.christmas_calendar_available_day
    if not availDay then
        return false
    end

    local calId = holidayRewards._login_calendar_id
    local calData = session.profile_data.login_calendar and session.profile_data.login_calendar[calId]
    local alreadyClaimed = calData and calData.days_claimed and calData.days_claimed[tostring(availDay)]
    if alreadyClaimed then
        return false
    end

    log("Claiming Holiday Calendar Reward (Day " .. tostring(availDay) .. ")")
    pcall(function()
        GameModules:InvokeServer("claim_christmas_calendar_reward")
    end)

    if guiService and guiService.christmas_calendar_ui and guiService.christmas_calendar_ui.IsOpen then
        pcall(function()
            guiService.christmas_calendar_ui:hide(true)
        end)
    end

    return true
end

function DailyService:ClaimLevelMilestones()
    if not Config.AutoClaimLevelMilestones then
        return 0
    end

    local session = GameModules.Session
    local rewardsData = GameModules.PlayerLevelRewards
    if not session or not session.profile_data or type(rewardsData) ~= "table" then
        return 0
    end

    local claimedTable = session.profile_data.level_rewards_claimed or {}
    local playerLevel = GameModules:GetPlayerLevel()
    local claimedCount = 0

    for _, entry in pairs(rewardsData) do
        local reqLvl = tonumber(entry.level)
        if reqLvl and playerLevel >= reqLvl and not claimedTable[entry.level] and not claimedTable[reqLvl] then
            log("Claiming Player Level Milestone Reward: Lv. " .. tostring(entry.level))
            pcall(function()
                GameModules:InvokeServer("claim_player_level_rewards", entry.level)
            end)
            claimedCount = claimedCount + 1
            task.wait(0.2)
        end
    end

    return claimedCount
end

function DailyService:ClaimCompletedQuests()
    if not Config.AutoClaimQuests then
        return 0
    end

    local session = GameModules.Session
    local quests = session
        and session.quest_handler
        and session.quest_handler.quest_profile_data
        and session.quest_handler.quest_profile_data.quests
    if type(quests) ~= "table" then
        return 0
    end

    local claimedCount = 0
    for uuid, q in pairs(quests) do
        local isCompleted = false
        pcall(function()
            if type(q.is_completed) == "function" then
                isCompleted = q:is_completed()
            elseif q.quest_progress and q.quest_info and q.quest_info.quest_class then
                local goal = q.quest_info.quest_class.amount or q.quest_info.quest_class.goal
                local prog = q.quest_progress.amount or q.quest_progress.progress
                if type(goal) == "number" and type(prog) == "number" and prog >= goal then
                    isCompleted = true
                end
            end
        end)

        if isCompleted then
            log("Claiming completed quest UUID: " .. tostring(uuid))
            pcall(function()
                GameModules:InvokeServer("redeem_quest", uuid)
            end)
            claimedCount = claimedCount + 1
            task.wait(0.2)
        end
    end

    return claimedCount
end

function DailyService:ClaimAll()
    if not GameModules.Loader or not GameModules.Loader.IsLobby then
        return
    end

    log("Running DailyService checks")
    self:ClaimDailyReward()
    self:ClaimHolidayCalendar()
    self:ClaimLevelMilestones()
    self:ClaimCompletedQuests()
end

-- ============================================================================
-- MODULE: SummonService (Auto Summon Banner with Tickets & Gems)
-- ============================================================================
local SummonService = {
    Running = false,
}

function SummonService:GetSummonTicketCount()
    local session = GameModules.Session
    if not session or not session.inventory then
        return 0
    end
    local ok, count = pcall(function()
        return session.inventory:get_number_of_owned_item("summon_ticket")
    end)
    return (ok and tonumber(count)) or 0
end

function SummonService:GetGemCosts(bannerName)
    local banners = GameModules.Banners
    local bannerDef = banners and banners[bannerName]
    local baseGemCost = (bannerDef and bannerDef.gem_cost) or 50
    local summonCore = GameModules.SummonServiceCore
    local session = GameModules.Session

    local singleCost = baseGemCost
    if summonCore and session then
        local ok, calc = pcall(function()
            return summonCore.calculate_hatch_price(session, baseGemCost, "gems")
        end)
        if ok and type(calc) == "number" and calc > 0 then
            singleCost = calc
        end
    end

    return singleCost, singleCost * 10
end

function SummonService:WaitUntilHatchComplete(timeout)
    timeout = timeout or 12
    local guiService = GameModules.GUIService
    local summonUI = guiService and guiService.summon_ui
    if not summonUI then
        return
    end

    local t0 = os.clock()
    while summonUI.hatching and (os.clock() - t0 < timeout) do
        if summonUI.unitInfoGUI and summonUI.unitInfoGUI.Enabled then
            JoinStart:TriggerMouseClick()
            task.wait(0.2)
        else
            task.wait(0.1)
        end
    end
end

function SummonService:ShouldStopByTargetRarity()
    if Config.StopSummonOnSecret and WebhookService.ObtainedSecretInSession then
        log("Stopping AutoSummon: Obtained Secret unit in session")
        return true
    end
    if Config.StopSummonOnMythic and WebhookService.ObtainedMythicInSession then
        log("Stopping AutoSummon: Obtained Mythic unit in session")
        return true
    end
    return false
end

function SummonService:Run()
    if not Config.AutoSummonEnabled or self.Running then
        return
    end

    if not GameModules.Loader or not GameModules.Loader.IsLobby then
        return
    end

    local playerLevel = GameModules:GetPlayerLevel()
    if Config.AutoFarmEnabled and playerLevel < (Config.TargetFarmLevel or 1) then
        log(string.format("Skipping SummonService: Player Level (%d) < TargetFarmLevel (%d)", playerLevel, Config.TargetFarmLevel))
        return
    end

    local bannerName = Config.SummonBanner or "EventClover"
    local banners = GameModules.Banners
    local bannerDef = banners and banners[bannerName]
    if not bannerDef then
        warn("[Main] Invalid SummonBanner in Config: " .. tostring(bannerName))
        return
    end

    self.Running = true
    local singleCost, tenCost = self:GetGemCosts(bannerName)
    local keepGems = Config.KeepGemAmount or 0
    log(string.format("Starting SummonService on banner '%s' (1x=%d Gems, 10x=%d Gems, Keep=%d)", bannerName, singleCost, tenCost, keepGems))

    -- 1. Use Summon Tickets first if enabled and allowed on banner
    if Config.UseSummonTickets and not bannerDef._no_summon_ticket then
        while self.Running and not self:ShouldStopByTargetRarity() do
            local tickets = self:GetSummonTicketCount()
            if tickets <= 0 then
                break
            end

            log(string.format("Summoning 1x with Summon Ticket on %s (Tickets left: %d)", bannerName, tickets))
            pcall(function()
                GameModules:InvokeServer("buy_from_banner", bannerName, "ticket")
            end)
            task.wait(Config.SummonDelay or 0.4)
            self:WaitUntilHatchComplete(10)
        end
    end

    -- 2. Use Gems (gems10 then gems)
    while self.Running and not self:ShouldStopByTargetRarity() do
        local currentGems = GameModules:GetGemAmount()
        local spendableGems = currentGems - keepGems

        if Config.PreferTenPull and spendableGems >= tenCost then
            log(string.format("Summoning 10x on %s (Gems: %d)", bannerName, currentGems))
            pcall(function()
                GameModules:InvokeServer("buy_from_banner", bannerName, "gems10")
            end)
            task.wait(Config.SummonDelay or 0.4)
            self:WaitUntilHatchComplete(12)
        elseif Config.AllowSinglePull and spendableGems >= singleCost then
            log(string.format("Summoning 1x on %s (Gems: %d)", bannerName, currentGems))
            pcall(function()
                GameModules:InvokeServer("buy_from_banner", bannerName, "gems")
            end)
            task.wait(Config.SummonDelay or 0.4)
            self:WaitUntilHatchComplete(10)
        else
            break
        end
    end

    self.Running = false
    log(string.format("SummonService finished (Remaining Gems: %d)", GameModules:GetGemAmount()))
end

