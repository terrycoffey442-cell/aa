    elseif type(fluxus) == "table" and type(fluxus.request) == "function" then
        return fluxus.request
    end
    return nil
end

function WebhookService:FormatUnitStats(unitData)
    if not unitData or type(unitData.trait_stats) ~= "table" then
        return "N/A"
    end

    local traitService = GameModules.TraitServiceCore
    local unitId = unitData.unit_id
    local stats = unitData.trait_stats

    local order = {
        { key = "potency_stat", label = "ATK" },
        { key = "speed_stat", label = "SPA" },
        { key = "range_stat", label = "RNG" },
    }

    local parts = {}
    for _, item in ipairs(order) do
        local val = stats[item.key]
        if type(val) == "number" and traitService then
            local okRank, rank = pcall(traitService.calculate_stat_rank, unitId, stats, item.key, val)
            local okPct, pctText = pcall(traitService.calculate_stat_text, unitData, item.key, val)
            rank = (okRank and rank) or "?"
            pctText = (okPct and pctText) or string.format("%+.1f%%", (val - 1) * 100)
            table.insert(parts, string.format("%s: **%s** (%s)", item.label, tostring(rank), tostring(pctText)))
        end
    end

    if #parts == 0 then
        return "N/A"
    end
    return table.concat(parts, " | ")
end

function WebhookService:FormatUnitTraits(unitData)
    if not unitData or type(unitData.traits) ~= "table" or #unitData.traits == 0 then
        return "None"
    end

    local traitsData = GameModules.Traits
    local traitService = GameModules.TraitServiceCore
    local list = {}

    for _, t in ipairs(unitData.traits) do
        local tId = t.trait
        local tTier = tostring(t.tier or "1")
        local def = traitsData and traitsData[tId]
        local name = (def and def.name) or tostring(tId)
        if def and not def.singular and traitService then
            local roman = traitService.convert_to_roman_numerals(tTier)
            name = name .. " " .. tostring(roman)
        end
        table.insert(list, name)
    end

    return table.concat(list, ", ")
end

function WebhookService:BuildUnitEmbed(unitData, customTitle)
    local unitId = unitData and unitData.unit_id or "unknown"
    local unitDef = (GameModules.Units and GameModules.Units[unitId]) or {}
    local unitName = unitDef.name or unitId
    local rarity = unitDef.rarity or "Unknown"
    local isShiny = unitData and unitData.shiny == true
    local shinyTag = isShiny and "[SHINY] " or ""
    local imageUrl = UnitImages:GetUrl(unitId)

    local player = Players.LocalPlayer
    local username = player and player.Name or "Unknown"
    if Config.WebhookHideUsername and #username > 3 then
        username = "||" .. username .. "||"
    end

    local level = GameModules:GetPlayerLevel()
    local gems = GameModules:GetGemAmount()
    local statsStr = self:FormatUnitStats(unitData)
    local traitsStr = self:FormatUnitTraits(unitData)
    local ownedCount = (GameModules.Session and GameModules.Session.collection and GameModules.Session.collection:size()) or 0

    local embed = {
        title = customTitle or string.format("%s%s (%s)", shinyTag, unitName, rarity),
        color = self.RarityColors[rarity] or 0xFFFFFF,
        fields = {
            {
                name = "Account",
                value = string.format("%s (Lv. %d)", username, level),
                inline = true,
            },
            {
                name = "Unit",
                value = string.format("**%s%s**\n`%s`", shinyTag, unitName, unitId),
                inline = true,
            },
            {
                name = "Rarity",
                value = string.format("**%s**", rarity),
                inline = true,
            },
            {
                name = "Stats (ATK / SPA / RNG)",
                value = statsStr,
                inline = false,
            },
            {
                name = "Traits",
                value = traitsStr,
                inline = true,
            },
            {
                name = "Gems / Units",
                value = string.format("Gems: **%d** | Units: **%d**", gems, ownedCount),
                inline = true,
            },
        },
        footer = {
            text = "Anime Adventures Webhook | UUID: " .. tostring(unitData and unitData.uuid or "N/A"),
        },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
    }

    if Config.WebhookUseLargeImage then
        embed.image = { url = imageUrl }
    else
        embed.thumbnail = { url = imageUrl }
    end

    return embed
end

function WebhookService:GetActiveWebhookUrls()
    local urls = {}
    local seen = {}

    local function addUrl(u)
        if type(u) == "string" then
            local trimmed = string.match(u, "^%s*(.-)%s*$")
            if trimmed and trimmed ~= "" and not seen[trimmed] then
                seen[trimmed] = true
                table.insert(urls, trimmed)
            end
        end
    end

    addUrl(Config.GlobalWebhookUrl)
    addUrl(Config.WebhookUrl)
    return urls
end

function WebhookService:SendPayload(payloadTable)
    if not Config.WebhookEnabled then
        return false, "Webhook disabled"
    end

    local urls = self:GetActiveWebhookUrls()
    if #urls == 0 then
        warn("[Main] Both GlobalWebhookUrl and WebhookUrl are empty in Config")
        return false, "WebhookUrl is empty"
    end

    local reqFn = self:GetRequestFunction()
    if not reqFn then
        warn("[Main] Executor does not support HTTP request function")
        return false, "No HTTP request function"
    end

    local bodyOk, bodyJson = pcall(function()
        return HttpService:JSONEncode(payloadTable)
    end)
    if not bodyOk then
        return false, "JSONEncode failed"
    end

    local anySuccess = false
    local lastStatus = 0

    for _, targetUrl in ipairs(urls) do
        local sendOk, response = pcall(function()
            return reqFn({
                Url = targetUrl,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                },
                Body = bodyJson,
            })
        end)

        if sendOk then
            anySuccess = true
            lastStatus = type(response) == "table" and (response.StatusCode or response.Status) or 0
            log("Webhook sent, status: " .. tostring(lastStatus))
        else
            warn("[Main] Webhook request error: " .. tostring(response))
        end
    end

    return anySuccess, lastStatus
end

function WebhookService:SendUnitNotification(unitData, customTitle)
    local embed = self:BuildUnitEmbed(unitData, customTitle)
    local payload = {
        username = "Anime Adventures Notifier",
        embeds = { embed },
    }
    if type(Config.WebhookPingContent) == "string" and Config.WebhookPingContent ~= "" then
        payload.content = Config.WebhookPingContent
    end
    return self:SendPayload(payload)
end

function WebhookService:ShouldNotifyUnit(unitData)
    if not Config.WebhookEnabled or not unitData or not unitData.unit_id then
        return false
    end
    local unitDef = GameModules.Units and GameModules.Units[unitData.unit_id]
    if not unitDef or not unitDef.rarity then
        return false
    end
    return Config.WebhookRarities[unitDef.rarity] == true
end

function WebhookService:OnUnitObtained(unitData)
    if unitData and unitData.unit_id and GameModules.Units and GameModules.Units[unitData.unit_id] then
        local rarity = GameModules.Units[unitData.unit_id].rarity
        if rarity == "Mythic" then
            self.ObtainedMythicInSession = true
        elseif rarity == "Secret" then
            self.ObtainedSecretInSession = true
        end
    end

    if not self:ShouldNotifyUnit(unitData) then
        return
    end
    local unitDef = GameModules.Units[unitData.unit_id]
    log(string.format("Detected target unit obtained: %s (%s)", tostring(unitDef.name), tostring(unitDef.rarity)))
    self:SendUnitNotification(unitData)
end

function WebhookService:HookUnitAdded()
    if self.Hooked then
        return
    end

    local collectionService = GameModules.UnitCollectionServiceClient
    if not collectionService then
        return
    end

    if not collectionService._orig_on_unit_added then
        collectionService._orig_on_unit_added = collectionService.on_unit_added
    end

    collectionService.on_unit_added = function(unitData)
        local res = collectionService._orig_on_unit_added(unitData)
        task.spawn(function()
            local ok, err = pcall(function()
                self:OnUnitObtained(unitData)
            end)
            if not ok then
                warn("[Main] Webhook OnUnitObtained error: " .. tostring(err))
            end
        end)
        task.spawn(function()
            if TrackerService and TrackerService.PushSummon then
                local banner = SummonService and SummonService.CurrentBanner or "Standard"
                local currency = SummonService and SummonService.CurrentCurrency or "gems"
                pcall(function()
                    TrackerService:PushSummon(unitData, banner, currency)
                end)
            end
        end)
        return res
    end

    self.Hooked = true
    log("Hooked UnitCollectionServiceClient.on_unit_added for Webhook")
end

