function FarmService:SetupTeleportAutoReload()
    if not Config.AutoReloadOnTeleport or self.TeleportQueued then
        return
    end

    local qot = (type(queue_on_teleport) == "function" and queue_on_teleport)
        or (type(syn) == "table" and type(syn.queue_on_teleport) == "function" and syn.queue_on_teleport)
        or (type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" and fluxus.queue_on_teleport)

    if not qot then
        return
    end

    local encodedUserConfig = ""
    if type(getgenv) == "function" and type(getgenv().Config) == "table" then
        pcall(function()
            encodedUserConfig = HttpService:JSONEncode(getgenv().Config)
        end)
    end

    local payload = string.format([[
        task.spawn(function()
            if not game:IsLoaded() then
                game.Loaded:Wait()
            end
            local rawCfg = %q
            if rawCfg ~= "" and type(getgenv) == "function" then
                pcall(function()
                    getgenv().Config = game:GetService("HttpService"):JSONDecode(rawCfg)
                end)
            end
            if type(isfile) == "function" and type(readfile) == "function" and isfile("aa_main_autoload.lua") then
                local fn = loadstring(readfile("aa_main_autoload.lua"))
                if fn then
                    fn()
                    return
                end
            end
            loadstring(game:HttpGet(%q))()
        end)
    ]], encodedUserConfig, GITHUB_SCRIPT_URL)

    local ok = pcall(function()
        qot(payload)
    end)

    if ok then
        self.TeleportQueued = true
        log("Registered queue_on_teleport for Kaitun autoload")
    end
end

function FarmService:TriggerVoteStart()
    if not Config.AutoVoteStart then
        return false
    end

    if GameModules.RematchServiceClient and GameModules.RematchServiceClient.active then
        return false
    end

    local guiService = GameModules.GUIService
    local dataFolder = workspace:FindFirstChild("_DATA")
    local gameStarted = dataFolder and dataFolder:FindFirstChild("GameStarted") and dataFolder.GameStarted.Value
    local voteStartFolder = dataFolder and dataFolder:FindFirstChild("VoteStart")
    local votingFinished = voteStartFolder and voteStartFolder:FindFirstChild("VotingFinished") and voteStartFolder.VotingFinished.Value

    -- Skip NewArea intro banner so VoteStart is not delayed by 3.5s
    local newAreaGui = guiService and guiService.new_area_gui
    if newAreaGui and (not newAreaGui.shown_once or (newAreaGui.screenGUI and newAreaGui.screenGUI.Enabled)) then
        pcall(function()
            newAreaGui:stop_tweens()
            newAreaGui.shown_once = true
            newAreaGui:hide()
        end)
    end

    local startVoteUI = guiService and guiService.start_vote_ui
    if gameStarted or votingFinished then
        if startVoteUI and startVoteUI.screenGUI and startVoteUI.screenGUI.Enabled then
            pcall(function()
                startVoteUI.screenGUI.Enabled = false
            end)
        end
        return false
    end

    if startVoteUI then
        pcall(function()
            if not startVoteUI.voted and voteStartFolder and voteStartFolder:FindFirstChild("Votes") then
                voteStartFolder.Votes.Value = voteStartFolder.Votes.Value + 1
                startVoteUI.voted = true
                startVoteUI:update_vote_count(voteStartFolder.Votes.Value)
            end
        end)
    end

    pcall(function()
        GameModules:InvokeServer("vote_start")
    end)

    if startVoteUI and startVoteUI.screenGUI then
        pcall(function()
            startVoteUI.screenGUI.Enabled = false
        end)
    end

    return true
end

