function GameModules:WaitForServerReady(timeout)
    local startClock = os.clock()
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end

    local localPlayer = Players.LocalPlayer
    while not localPlayer do
        if os.clock() - startClock > timeout then
            return false, "Timeout waiting for LocalPlayer"
        end
        task.wait(0.1)
        localPlayer = Players.LocalPlayer
    end

    while not workspace:FindFirstChild("_initial_client_ready") do
        if os.clock() - startClock > timeout then
            return false, "Timeout waiting for _initial_client_ready"
        end
        task.wait(0.1)
    end

    local serverReady = workspace:FindFirstChild("SERVER_READY")
    while not (serverReady and serverReady.Value) do
        if os.clock() - startClock > timeout then
            return false, "Timeout waiting for SERVER_READY"
        end
        task.wait(0.1)
        serverReady = workspace:FindFirstChild("SERVER_READY")
    end

    return true
end

function GameModules:Init(timeout)
    if self.Initialized and self.Session then
        return true
    end

    timeout = timeout or Config.JoinTimeout
    local startClock = os.clock()

    local ok, err = self:WaitForServerReady(timeout)
    if not ok then
        warn("[Main] " .. tostring(err))
        return false
    end

    local srcFolder = ReplicatedStorage:WaitForChild("src", 10)
    if not srcFolder then
        warn("[Main] ReplicatedStorage.src not found")
        return false
    end

    self.Loader = require(srcFolder:WaitForChild("Loader"))
    self.Util = require(srcFolder:WaitForChild("Util"))

    while os.clock() - startClock < timeout do
        local loadedOk = pcall(function()
            self.EndpointsClient = self.Loader.load_client_service(nil, "EndpointsClient")
            self.GUIService = self.Loader.load_client_service(nil, "GUIService")
            self.LoginServiceClient = self.Loader.load_client_service(nil, "LoginServiceClient")
            self.SummonServiceClient = self.Loader.load_client_service(nil, "SummonServiceClient")
            self.SummonFX = self.Loader.load_client_service(nil, "SummonFX")
            self.UnitCollectionServiceClient = self.Loader.load_client_service(nil, "UnitCollectionServiceClient")
            self.StatsServiceClient = self.Loader.load_client_service(nil, "StatsServiceClient")
            self.TraitServiceCore = self.Loader.load_core_service(nil, "TraitServiceCore")
            self.LevelServiceCore = self.Loader.load_core_service(nil, "LevelServiceCore")
            self.ProgressionServiceCore = self.Loader.load_core_service(nil, "ProgressionServiceCore")
            self.SummonServiceCore = self.Loader.load_core_service(nil, "SummonServiceCore")
            self.SpecialEventServiceClient = self.Loader.load_client_service(nil, "SpecialEventServiceClient")
            self.Units = self.Loader.load_data(nil, "Units")
            self.Traits = self.Loader.load_data(nil, "Traits")
            self.Banners = self.Loader.load_data(nil, "Banners")
            self.GameplaySettings = self.Loader.load_data(nil, "GameplaySettings")
            self.HolidayRewards = self.Loader.load_data(nil, "HolidayRewards")
            self.PlayerLevelRewards = self.Loader.load_data(nil, "PlayerLevelRewards")
        end)

        local sessionRef = (self.LoginServiceClient and self.LoginServiceClient.session)
            or (self.GUIService and self.GUIService.session)
            or (self.EndpointsClient and self.EndpointsClient.session)

        if loadedOk and sessionRef and self.GUIService and self.EndpointsClient then
            self.Session = sessionRef
            self.Initialized = true
            return true
        end

        task.wait(0.1)
    end

    warn("[Main] Timeout waiting for client services session initialization")
    return false
end

function GameModules:InvokeServer(endpointName, ...)
    if not self.EndpointsClient then
        return nil
    end
    return self.EndpointsClient.invoke_server(endpointName, ...)
end

function GameModules:GetGemAmount()
    local ok, val = pcall(function()
        return self.StatsServiceClient.stats.gem_amount.Value
    end)
    if ok and type(val) == "number" then
        return val
    end
    if self.Session and self.Session.profile_data and self.Session.profile_data.resources then
        return self.Session.profile_data.resources.gem_amount or 0
    end
    return 0
end

function GameModules:GetPlayerLevel()
    local ok, lvl = pcall(function()
        local player = Players.LocalPlayer
        local xp = player._stats.player_xp.Value
        return self.LevelServiceCore.calculate_level(player, xp)
    end)
    return (ok and lvl) or 1
end

