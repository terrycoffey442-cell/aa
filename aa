-- MODULE: UnitImages (Wiki CDN Asset Mapping by unit_id)
-- ============================================================================
local UnitImages = {
    CDNPrefix = "https://static.wikia.nocookie.net/animeadventures/images/",
    CDNSuffix = "",
    FallbackUrl = "https://static.wikia.nocookie.net/animeadventures/images/e/e6/Site-logo.png",
    Map = {},
}

function UnitImages:GetUrl(unitId)
    if not unitId then
        return self.FallbackUrl
    end

    local entry = self.Map[unitId]
    if not entry and GameModules.Units and GameModules.Units[unitId] then
        local uDef = GameModules.Units[unitId]
        if type(uDef.evolved) == "table" and uDef.evolved.from then
            entry = self.Map[uDef.evolved.from]
        end
    end

    if not entry then
        return self.FallbackUrl
    end

    if string.sub(entry, 1, 4) == "http" then
        return (string.gsub(entry, "/revision/latest.*$", ""))
    end

    return self.CDNPrefix .. entry .. self.CDNSuffix
end

