-- MODULE: FarmService (Planet Greenie World Skip + AFK Loss + Replay Loop)
-- ============================================================================
local FarmService = {
    Running = false,
    VoteSkipHooked = false,
    VoteStartHooked = false,
    TeleportQueued = false,
}

function FarmService:SetupTeleportAutoReload()
    if not Config.AutoReloadOnTeleport or self.TeleportQueued then
        return
    end

    local qot = (type(queue_on_teleport) == "function" and queue_on_teleport)
        or (type(syn) == "table" and type(syn.queue_on_teleport) == "function" and syn.queue_on_teleport)
        or (type(fluxus) == "table" and type(fluxus.queue_on_teleport) == "function" and fluxus.queue_on_teleport)

    if not qot then
        return
    end

    local ok = pcall(function()
        qot([[
            task.spawn(function()
                if not game:IsLoaded() then
                    game.Loaded:Wait()
                end
                if type(isfile) == "function" and type(readfile) == "function" and isfile("aa_main_autoload.lua") then
                    local fn = loadstring(readfile("aa_main_autoload.lua"))
                    if fn then
                        fn()
                    end
                end
            end)
        ]])
    end)

    if ok then
        self.TeleportQueued = true
        log("Registered queue_on_teleport for aa_main_autoload.lua")
    end
end

function FarmService:TriggerVoteStart()
    if not Config.AutoVoteStart then
        return false
    end

    local guiService = GameModules.GUIService
    local dataFolder = workspace:FindFirstChild("_DATA")
    local gameStarted = dataFolder and dataFolder:FindFirstChild("GameStarted") and dataFolder.GameStarted.Value
    local voteStartFolder = dataFolder and dataFolder:FindFirstChild("VoteStart")
    local votingFinished = voteStartFolder and voteStartFolder:FindFirstChild("VotingFinished") and voteStartFolder.VotingFinished.Value

    -- Skip NewArea intro banner so VoteStart is not delayed by 3.5s
    local newAreaGui = guiService and guiService.new_area_gui
    if newAreaGui and (not newAreaGui.shown_once or (newAreaGui.screenGUI and newAreaGui.screenGUI.Enabled)) then
        pcall(function()
            newAreaGui:stop_tweens()
            newAreaGui.shown_once = true
            newAreaGui:hide()
        end)
    end

    local startVoteUI = guiService and guiService.start_vote_ui
    if gameStarted or votingFinished then
        if startVoteUI and startVoteUI.screenGUI and startVoteUI.screenGUI.Enabled then
            pcall(function()
                startVoteUI.screenGUI.Enabled = false
            end)
        end
        return false
    end

    if startVoteUI then
        pcall(function()
            if not startVoteUI.voted and voteStartFolder and voteStartFolder:FindFirstChild("Votes") then
                voteStartFolder.Votes.Value = voteStartFolder.Votes.Value + 1
                startVoteUI.voted = true
                startVoteUI:update_vote_count(voteStartFolder.Votes.Value)
            end
        end)
    end

    pcall(function()
        GameModules:InvokeServer("vote_start")
    end)

    if startVoteUI and startVoteUI.screenGUI then
        pcall(function()
            startVoteUI.screenGUI.Enabled = false
        end)
    end

    return true
end

function FarmService:HookVoteStartUI()
    if self.VoteStartHooked then
        return
    end

    local guiService = GameModules.GUIService
    local startVoteUI = guiService and guiService.start_vote_ui
    if not startVoteUI then
        return
    end

    if not startVoteUI._orig_update_visibility then
        startVoteUI._orig_update_visibility = startVoteUI.update_visibility
    end

    startVoteUI.update_visibility = function(uiSelf, ...)
        local res = startVoteUI._orig_update_visibility(uiSelf, ...)
        if Config.AutoVoteStart then
            task.spawn(function()
                self:TriggerVoteStart()
            end)
        end
        return res
    end

    self.VoteStartHooked = true
    log("Hooked StartVoteUI.update_visibility for instant Vote Start")
end

function FarmService:ShouldFarm()
    if not Config.AutoFarmEnabled then
        return false
    end
    local playerLevel = GameModules:GetPlayerLevel()
    local targetLevel = tonumber(Config.TargetFarmLevel) or 20
    return playerLevel < targetLevel
end

function FarmService:FindEmptyStoryLobby()
    local lobbiesRoot = workspace:FindFirstChild("_LOBBIES")
    local storyFolder = lobbiesRoot and lobbiesRoot:FindFirstChild("Story")
    if not storyFolder then
        return nil
    end

    for _, model in ipairs(storyFolder:GetChildren()) do
        local owner = model:FindFirstChild("Owner") and model.Owner.Value
        local active = model:FindFirstChild("Active") and model.Active.Value
        if not owner and not active then
            return model
        end
    end

    return nil
end

function FarmService:EnterStoryMatch()
    if not GameModules.Loader or not GameModules.Loader.IsLobby then
        return false
    end

    local playerLevel = GameModules:GetPlayerLevel()
    local targetLevel = tonumber(Config.TargetFarmLevel) or 20
    log(string.format("Player Level (%d) < TargetFarmLevel (%d), entering Story match", playerLevel, targetLevel))

    local targetWorld = Config.FarmWorld or "namek"
    local targetStage = Config.FarmLevel or "namek_level_6"
    local difficulty = Config.FarmDifficulty or "Normal"

    for attempt = 1, 10 do
        local lobbyModel = self:FindEmptyStoryLobby()
        if lobbyModel then
            log(string.format("Joining Story lobby: %s (Attempt %d)", lobbyModel.Name, attempt))
            local joined = false
            pcall(function()
                joined = GameModules:InvokeServer("request_join_lobby", lobbyModel.Name) == true
            end)

            if joined then
                task.wait(0.2)

                -- Close any World Skip UI popup if open
                local guiService = GameModules.GUIService
                if guiService and guiService.notification_windows_ui then
                    pcall(function()
                        guiService.notification_windows_ui:hide()
                    end)
                end

                -- Method 1: Use World Skip (lobby_world_skip) for instant teleport into Act 6
                if Config.UseWorldSkip then
                    log(string.format("Invoking lobby_world_skip('%s') for instant match start", targetWorld))
                    pcall(function()
                        GameModules:InvokeServer("lobby_world_skip", targetWorld)
                    end)
                    task.wait(1.5)
                end

                -- Method 2: Standard lock level + start game (if World Skip already completed or disabled)
                local locked = false
                pcall(function()
                    locked = GameModules:InvokeServer("request_lock_level", lobbyModel.Name, targetStage, true, difficulty) == true
                end)

                if not locked and targetStage ~= "namek_level_1" then
                    pcall(function()
                        locked = GameModules:InvokeServer("request_lock_level", lobbyModel.Name, "namek_level_1", true, difficulty) == true
                    end)
                end

                if locked then
                    task.wait(0.2)
                    log("Starting Story match via request_start_game")
                    pcall(function()
                        GameModules:InvokeServer("request_start_game", lobbyModel.Name)
                    end)
                end

                return true
            end
        end
        task.wait(1)
    end

    warn("[Main] Failed to find or join an empty Story lobby")
    return false
end

function FarmService:EnableAutoSkipSetting()
    if not Config.AutoSkipWaves then
        return
    end

    local player = Players.LocalPlayer
    local settingsFolder = player and player:FindFirstChild("_settings")
    local autoSkipVal = settingsFolder and settingsFolder:FindFirstChild("autoskip_waves")
    if autoSkipVal and not autoSkipVal.Value then
        pcall(function()
            autoSkipVal.Value = true
            GameModules:InvokeServer("toggle_setting", "autoskip_waves", true)
        end)
        log("Enabled autoskip_waves setting")
    end

    local guiService = GameModules.GUIService
    local voteWaveUI = guiService and guiService.vote_wave_ui
    if voteWaveUI and not self.VoteSkipHooked then
        if not voteWaveUI._orig_on_start_vote_wave_skip then
            voteWaveUI._orig_on_start_vote_wave_skip = voteWaveUI.on_start_vote_wave_skip
        end
        voteWaveUI.on_start_vote_wave_skip = function(uiSelf, ...)
            if Config.AutoSkipWaves then
                task.spawn(function()
                    pcall(function()
                        GameModules:InvokeServer("vote_wave_skip")
                    end)
                end)
            end
            return voteWaveUI._orig_on_start_vote_wave_skip(uiSelf, ...)
        end
        self.VoteSkipHooked = true
    end
end

function FarmService:RunInGame()
    if GameModules.Loader and GameModules.Loader.IsLobby then
        return
    end
    if self.Running then
        return
    end

    self.Running = true
    log("Starting In-Game AFK Loss & Replay loop")
    self:EnableAutoSkipSetting()
    self:HookVoteStartUI()
    self:TriggerVoteStart()

    task.spawn(function()
        local lastVoteStart = 0
        local lastVoteSkip = 0
        local handledResultsForMatch = false

        while self.Running do
            local guiService = GameModules.GUIService
            local dataFolder = workspace:FindFirstChild("_DATA")
            local gameStarted = dataFolder and dataFolder:FindFirstChild("GameStarted") and dataFolder.GameStarted.Value
            local voteStartFolder = dataFolder and dataFolder:FindFirstChild("VoteStart")
            local votingFinished = voteStartFolder and voteStartFolder:FindFirstChild("VotingFinished") and voteStartFolder.VotingFinished.Value

            -- 1. Vote Start before match begins (and dismiss VoteStart UI if shown)
            if Config.AutoVoteStart then
                local startVoteUI = guiService and guiService.start_vote_ui
                local uiShown = startVoteUI and startVoteUI.screenGUI and startVoteUI.screenGUI.Enabled
                if (not gameStarted and not votingFinished) or uiShown then
                    if os.clock() - lastVoteStart >= 0.5 then
                        lastVoteStart = os.clock()
                        self:TriggerVoteStart()
                    end
                end
            end

            -- 2. Vote Wave Skip during match so mobs destroy base faster
            if Config.AutoSkipWaves and gameStarted then
                local voteWaveUI = guiService and guiService.vote_wave_ui
                if voteWaveUI and voteWaveUI.screenGUI and voteWaveUI.screenGUI.Enabled then
                    if os.clock() - lastVoteSkip >= 0.5 then
                        lastVoteSkip = os.clock()
                        pcall(function()
                            if GameModules:InvokeServer("vote_wave_skip") then
                                voteWaveUI.screenGUI.Enabled = false
                            end
                        end)
                    end
                end
            end

            -- 3. Handle ResultsUI on match finish (Defeat / Victory)
            local resultsUI = guiService and guiService.results_ui
            if resultsUI and resultsUI.screenGUI and resultsUI.screenGUI.Enabled then
                if not handledResultsForMatch then
                    handledResultsForMatch = true
                    task.wait(0.5)

                    pcall(function()
                        resultsUI.Holder.Visible = false
                        resultsUI.BG.Visible = false
                        resultsUI:show_unit_and_item_rewards()
                    end)

                    task.wait(0.3)
                    local currentLevel = GameModules:GetPlayerLevel()
                    local targetLevel = tonumber(Config.TargetFarmLevel) or 20

                    if Config.AutoFarmEnabled and currentLevel < targetLevel then
                        log(string.format("Match ended (Player Level: %d / %d) -> Voting Replay", currentLevel, targetLevel))
                        pcall(function()
                            GameModules:InvokeServer("set_game_finished_vote", "replay")
                        end)
                    else
                        log(string.format("Target Level reached (%d >= %d) -> Returning to Lobby", currentLevel, targetLevel))
                        pcall(function()
                            GameModules:InvokeServer("teleport_back_to_lobby")
                        end)
                    end
                else
                    -- Retry vote every 2s until server teleports
                    local currentLevel = GameModules:GetPlayerLevel()
                    local targetLevel = tonumber(Config.TargetFarmLevel) or 20
                    pcall(function()
                        if Config.AutoFarmEnabled and currentLevel < targetLevel then
                            GameModules:InvokeServer("set_game_finished_vote", "replay")
                        else
                            GameModules:InvokeServer("teleport_back_to_lobby")
                        end
                    end)
                    task.wait(1.5)
                end
            else
                handledResultsForMatch = false
            end

            task.wait(0.3)
        end
    end)
end

-- ============================================================================
-- MODULE: AntiAfkService (Disable Roblox 20m Idle Kick + VirtualUser Fallback)
-- ============================================================================
local AntiAfkService = {
    Started = false,
    IdledConnection = nil,
}

function AntiAfkService:Start()
    if not Config.AntiAfkEnabled or self.Started then
        return false
    end

    local player = Players.LocalPlayer
    if not player then
        return false
    end

    local disabledCount = 0
    if type(getconnections) == "function" then
        pcall(function()
            for _, conn in ipairs(getconnections(player.Idled)) do
                if type(conn.Disable) == "function" then
                    conn:Disable()
                    disabledCount = disabledCount + 1
                elseif type(conn.Disconnect) == "function" then
                    conn:Disconnect()
                    disabledCount = disabledCount + 1
                end
            end
        end)
    end

    local VirtualUser = nil
    pcall(function()
        VirtualUser = game:GetService("VirtualUser")
    end)

    self.IdledConnection = player.Idled:Connect(function()
        if not Config.AntiAfkEnabled then
            return
        end
        pcall(function()
            if VirtualUser then
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            elseif VirtualInputManager then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.RightControl, false, game)
                task.wait(0.05)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.RightControl, false, game)
            end
        end)
    end)

    self.Started = true
    log(string.format("AntiAfkService enabled (Disabled %d Idled connections + VirtualUser fallback)", disabledCount))
    return true
end

